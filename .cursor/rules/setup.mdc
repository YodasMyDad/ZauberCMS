## Workflows

If complex workflows are needed on background jobs then use WorkflowCore or code is needed to be run on demand that runs for a long period, also use WorkflowCore - See link below for more information

https://github.com/danielgerlag/workflow-core

And if parallel tasks are needed and can be used then they are used like so, where many workflows are set off at once, example code below

```C#
public class GetPlanningApplicationsJob(IWorkflowHost workflowHost, IServiceProvider serviceProvider) : IHostedService, IDisposable
{
    private Timer? _timer;

    public Task StartAsync(CancellationToken cancellationToken)
    {
        _timer = new Timer(DoWork, null, TimeSpan.Zero, TimeSpan.FromHours(12));
        return Task.CompletedTask;
    }

    private void DoWork(object? state)
    {
        using var scope = serviceProvider.CreateScope();
        var extensionManager = scope.ServiceProvider.GetRequiredService<ExtensionManager>();
        var allPlannerScrapers = extensionManager.GetInstances<IPlanningApplicationScraper>();
        
        // Start a separate workflow instance for each council
        foreach (var scraperKey in allPlannerScrapers.Keys)
        {
            var workflowData = new GetApplicationsWorkflowData 
            { 
                CouncilKey = scraperKey 
            };
            
            workflowHost.StartWorkflow(nameof(GetApplicationsWorkflow), 1, workflowData);
        }
        
        Console.WriteLine($"Started {allPlannerScrapers.Keys.Count} workflow instances");
    }

    public Task StopAsync(CancellationToken cancellationToken)
    {
        _timer?.Change(Timeout.Infinite, 0);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
```

Example of registering workflows in program.cs

```c#
using (var scope = app.Services.CreateScope())
{   
    var logger = scope.ServiceProvider.GetRequiredService<ILoggerFactory>()
        .CreateLogger("WorkflowCore");
    
    // Start Workflow Core host and register your workflow
    var workflowHost = scope.ServiceProvider.GetRequiredService<IWorkflowHost>();
    workflowHost.RegisterWorkflow<GetApplicationsWorkflow, GetApplicationsWorkflowData>();
    workflowHost.RegisterWorkflow<StatusChangeWorkflow, StatusChangeWorkflowData>();
    workflowHost.RegisterWorkflow<AppealStatusChangeWorkflow, StatusChangeWorkflowData>();
    workflowHost.Start();

    // In Program.cs, before starting the workflow
    workflowHost.OnStepError += (workflow, step, exception) => {
        logger.LogError(exception, "Error in workflow {WorkflowId}: Step {StepName}", workflow.WorkflowDefinitionId, step.Name);
    };
    
    /*
    // Optionally start a workflow instance here
    var initialData = new PlanningWorkflowData();
    var workflowId = await workflowHost.StartWorkflow(nameof(MainScraperWorkflow), 1, initialData);
    */
    
    // Register during app lifetime events
    app.Lifetime.ApplicationStopping.Register(() => {
        workflowHost.Stop();
    });
}
```

