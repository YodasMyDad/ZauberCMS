<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Routing brings Components and Core with it. All three are needed because the real bootstrap
             (ZauberSetup.AddZauberCms) loads ZauberCMS.Components and ZauberCMS.Routing by name. -->
        <ProjectReference Include="..\..\ZauberCMS.Routing\ZauberCMS.Routing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Bootstrap/Snapshots/*.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- An empty static web assets manifest, so a test can run the whole AddZauberCms<T> pipeline (MapStaticAssets
             reads <application>.staticwebassets.endpoints.json) -->
        <None Update="ZauberCMS.Core.Tests.staticwebassets.endpoints.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Testcontainers.PostgreSql" />
      <PackageReference Include="Testcontainers.Redis" />
    </ItemGroup>

</Project>
