@implements IContentView
@layout MainLayout
@inject IHtmlSanitizerService Sanitizer
@* The view of the "Text Page" page type: a heading and a block of rich text. *@

<PageTitle>@Content?.Name</PageTitle>

<article class="prose">
    <h1>@(Content?.GetValue<string>("Heading"))</h1>
    @Sanitizer.SanitizeToMarkup(Content?.GetValue<string>("Body"))
</article>

@code {
    [Parameter] public Content? Content { get; set; }
    [Parameter] public Dictionary<string, string>? LanguageKeys { get; set; }
}
