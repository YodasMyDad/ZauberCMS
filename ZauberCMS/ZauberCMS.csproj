<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>ZauberCMS</PackageId>
        <Description>The main ZauberCMS nuget package</Description>
        <IsPackable>true</IsPackable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <StaticWebAssetBasePath>_content/$(PackageId)</StaticWebAssetBasePath>
    </PropertyGroup>
    
    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Only the packages Components, Routing and Core do not bring (ZA-119). The Async sink is not used by the
             packed appsettings.json; it stays a dependency so a site's own Serilog configuration can keep using it. -->
        <PackageReference Include="Serilog.Sinks.Async" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZauberCMS.Components\ZauberCMS.Components.csproj"/>
        <ProjectReference Include="..\ZauberCMS.Routing\ZauberCMS.Routing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="appsettings.json" />
        <None Include="appsettings.json">
            <Pack>true</Pack>
            <PackagePath>build/settings.json</PackagePath>
        </None>
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="ZauberCMS.targets">
            <Pack>true</Pack>
            <PackagePath>build/ZauberCMS.targets</PackagePath>
        </Content>
    </ItemGroup>

</Project>
