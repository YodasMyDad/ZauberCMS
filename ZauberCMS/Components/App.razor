@using Microsoft.AspNetCore.Http
@using System.Globalization
@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Membership.Middleware
<!DOCTYPE html>
<html lang="@CurrentLanguage">
<head>
    @* The site's path base (UsePathBase), so a circuit's base address is the request's and the admin is found below
       it (ZA-199) *@
    <base href="@BaseHref"/>
    <HeadOutlet @rendermode="RenderModeForPage" />
    <ImportMap />
    @if (IsAdmin)
    {
        <RadzenTheme Theme="material" @rendermode="InteractiveServer" />
        @* In the head, not deferred: it applies the saved navigation width before the admin first paints *@
        <script src="@Assets["_content/ZauberCMS.Components/js/admin-sidebar.js"]"></script>

        <link rel="stylesheet" href="@Assets["_content/ZauberCMS.Components/ZauberCMS.Components.bundle.scp.css"]">
        <link rel="stylesheet" href="@Assets["_content/ZauberCMS.Components/css/admin.css"]">
        @foreach (var style in PageStyles)
        {
            <link rel="stylesheet" href="@Assets[style]">
        }
    }
</head>

<body>

<CascadingValue Value="IsAdmin">
    <Routes @rendermode="RenderModeForPage"/>
</CascadingValue>

<script src="@Assets["_framework/blazor.web.js"]"></script>

@if (IsAdmin)
{
    @* Served by the site with fingerprinted names (ZA-108): Sortable.js is shipped in the Components package
       (wwwroot/lib/sortablejs, MIT) instead of loaded from a CDN. An editor's own script that is not a static web
       asset keeps its address. *@
    <script src="@Assets["_content/ZauberCMS.Components/lib/sortablejs/Sortable.min.js"]"></script>
    <script src="@Assets["_content/ZauberCMS.Components/js/block-preview.js"]"></script>
    @foreach (var script in PageScripts)
    {
        <script src="@Assets[script]"></script>
    }
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js"]"></script>
}

</body>
</html>


@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string BaseHref => (HttpContext?.Request.PathBase ?? PathString.Empty).ToUriComponent() + "/";
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    
    private List<string> PageScripts { get; set; } = [];
    private List<string> PageStyles { get; set; } = [];
    
    // The property editors' scripts and styles, read once: they are only rendered in the admin, and making an
    // instance of every editor on every front-end request was the cost (ZA-063)
    private static (List<string> Scripts, List<string> Styles)? _editorAssets;

    protected override void OnInitialized()
    {
        if (!IsAdmin)
        {
            return;
        }

        _editorAssets ??= ReadEditorAssets();
        PageScripts = _editorAssets.Value.Scripts;
        PageStyles = _editorAssets.Value.Styles;
    }

    private (List<string> Scripts, List<string> Styles) ReadEditorAssets()
    {
        var contentProperties = ExtensionManager.GetInstances<IContentProperty>(true).Values.ToList();
        return (contentProperties.SelectMany(x => x.Scripts).Distinct().ToList(),
            contentProperties.SelectMany(x => x.Styles).Distinct().ToList());
    }

    // /admin and below, on whole segments: a site page at /administration is not the admin (ZA-095); below the
    // site's path base, which NavigationManager.Uri starts with (ZA-199)
    private bool IsAdmin => AdminAccess.IsAdminPath(NavigationManager);

    private IComponentRenderMode? RenderModeForPage
    {
        get
        {
            if (HttpContext == null)
            {
                return AdminRenderMode;
            }

            return IsAdmin ? AdminRenderMode : null;
        }
    }

    // The admin is not prerendered (ZA-101): a prerender ran every page's initialisation twice, once for the HTML
    // and again in the circuit, and showed data that the circuit then loaded again
    private static readonly IComponentRenderMode AdminRenderMode = new InteractiveServerRenderMode(prerender: false);

    private static string CurrentLanguage => CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}