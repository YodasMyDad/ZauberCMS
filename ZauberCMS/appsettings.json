{
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\log.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "shared": true
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
  },
  "Zauber": {
    "DatabaseProvider": "",
    "ConnectionString": "",
    "RedisConnectionString": "",
    "NewUserStartingRole": "Member",
    "AdminDefaultLanguage": "en-US",
    "EnablePathUrls": false,
    "UploadFolderName": "media",
    "Default404Url": "",
    "ErrorPagePath": "/error",
    "ContentVersionsToKeep": 50,
    "SiteUrl": "",
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "FormProtection": {
      "MinimumFillSeconds": 3
    },
    "HtmlSanitizer": {
      "AllowedIframeHosts": ["www.youtube.com", "www.youtube-nocookie.com", "player.vimeo.com"]
    },
    "ApiKeys": {
      "TinyMCE":""
    },
    "Identity": {
      "PasswordRequireDigit": true,
      "PasswordRequireLowercase": true,
      "PasswordRequireNonAlphanumeric": false,
      "PasswordRequireUppercase": true,
      "PasswordRequiredLength": 8,
      "PasswordRequiredUniqueChars": 1,
      "SignInRequireConfirmedAccount": false,
      "RecoverAdminUser": "",
      "AccountLayout": "ZauberCMS.Components.Pages.BlankLayout",
      "LoginRateLimit": { "PermitLimit": 10, "WindowMinutes": 5 },
      "RegisterRateLimit": { "PermitLimit": 5, "WindowMinutes": 10 },
      "ExternalProviders": {
        "Google": {
          "ClientId": "",
          "ClientSecret": ""
        },
        "Facebook": {
          "AppId": "",
          "AppSecret": "",
          "TrustEmail": false
        },
        "Microsoft": {
          "ClientId": "",
          "ClientSecret": "",
          "TrustEmail": false
        }
      }
    },
    "Email": {
      "SenderEmail": "",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Username": "",
        "Password": ""
      }
    },
    "Plugins": {
      "StorageProvider": "ZauberCMS.Core.Providers.DiskStorageProvider",
      "EmailProvider": "ZauberCMS.Core.Providers.SmtpEmailProvider",
      "CaptchaProvider": ""
    }
  },
  "AllowedHosts": "*"
}
