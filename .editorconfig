# Editor and analyser settings for the repository. Indentation matches the existing files; no rule here asks for a
# reformat of code that is not being changed. Analyser rule levels: Directory.Build.props and Roadmap D43. A rule
# that is turned down here says why.
root = true

[*]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{cs,razor}]
# Code style from Docs/Standards.md §2, shown by the IDE as suggestions (never build warnings).
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# CA1822 (mark members static): only for private and internal members. Making a public member static is a breaking
# change for its callers, so public members are left to the v5 API clean-up (Phase 11f).
dotnet_code_quality.CA1822.api_surface = private, internal

# CA1848 (use LoggerMessage delegates) and CA1873 (avoid potentially expensive logging): performance rules for
# logging on hot paths. ZauberCMS logs on error, start-up and admin paths; moving its ~125 log calls to
# source-generated LoggerMessage methods is a change of its own. Shown in the IDE, not a build warning.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# EF Core migrations are generated by migrations.ps1 and never edited by hand (AGENTS.md rule 1).
[ZauberCMS.Core/Data/Migrations/**.cs]
generated_code = true

[tests/**.cs]
# CA1816 (call GC.SuppressFinalize in Dispose): test classes have no finalizers and are not an API others derive from.
dotnet_diagnostic.CA1816.severity = none
# CA1859 (use concrete types for performance): the speed of a test helper does not matter.
dotnet_diagnostic.CA1859.severity = none
