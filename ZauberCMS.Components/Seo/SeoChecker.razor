@using HtmlAgilityPack
@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Seo
@using ZauberCMS.Core.Seo.Models
@using Microsoft.Extensions.Logging
@implements IDisposable

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.7em">
    <RadzenTextBox Style="width:26rem;" Placeholder="@(FullUrl)" @bind-Value="@_url" />
    <RadzenButton Variant="Variant.Filled" Size="ButtonSize.Small" Text="Run SEO Checks" Disabled="@ShowLoader"
                  Click="@(() => RunSeoChecks())"/>
    @if (ShowLoader)
    {
        <RadzenButton Variant="Variant.Outlined" Size="ButtonSize.Small" Text="Stop" Click="@StopSeoChecks"/>
    }
    <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" Visible="@ShowLoader">
        <Template>Wait</Template>
    </RadzenProgressBarCircular>
</RadzenStack>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="mt-2">
        <TailwindAlert Type="ZauberCMS.Core.Shared.Models.AlertType.Error" Title="SEO checks" DefaultMessage="@ErrorMessage" />
    </div>
}

<RadzenStack Orientation="Orientation.Vertical" Gap="1em" class="mt-2">
    @foreach (var check in SeoCheckResults)
    {
        foreach (var checkResultItem in check.Items)
        {
            <TailwindAlert Type="@checkResultItem.Status" Title="@check.Name" DefaultMessage="@checkResultItem.DefaultMessage" Messages="@checkResultItem.AdditionalMessages" />
        }
    }
</RadzenStack>

@code
{
    [Parameter] public Content? Content { get; set; }
    [Parameter] public string? FullUrl { get; set; }
    [Parameter] public bool RunNow { get; set; }
    
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Inject] public IHttpClientFactory HttpClientFactory { get; set; } = null!;
    [Inject] public ILogger<SeoChecker> Logger { get; set; } = null!;

    /// <summary>How long a run may take before it is stopped: the broken-links check alone can make 50 requests.</summary>
    private static readonly TimeSpan RunTimeLimit = TimeSpan.FromMinutes(3);

    // The current run: cancelled when the editor leaves, runs the checks again, presses Stop or the time is up (ZA-085)
    private CancellationTokenSource? _run;

    private List<SeoCheckResult> SeoCheckResults { get; set; } = [];
    private bool ShowLoader { get; set; }
    private string? ErrorMessage { get; set; }

    // The URL being checked, typed by the editor: the parent passes FullUrl again on every render, which would
    // otherwise overwrite what was typed (ZA-127)
    private string? _url;
    private string? _lastFullUrl;

    protected override void OnParametersSet()
    {
        if (_url == null || FullUrl != _lastFullUrl)
        {
            _url = FullUrl;
            _lastFullUrl = FullUrl;
        }
    }

    /*
    protected override async Task OnInitializedAsync()
    {
        if (RunNow && !FullUrl.IsNullOrWhiteSpace())
        {
            await Task.Delay(1000); // Add a 1-second delay
            await RunSeoChecks();
        }
    }
    */

    private async Task RunSeoChecks()
    {
        var results = new List<SeoCheckResult>();
        SeoCheckResults = results;
        ErrorMessage = null;

        if (!SeoHttp.IsHttpUrl(_url, out var pageUri))
        {
            ErrorMessage = "Enter the full address of the page, starting with http:// or https://";
            return;
        }

        _run?.Cancel();
        _run?.Dispose();
        var run = new CancellationTokenSource(RunTimeLimit);
        _run = run;
        _stopped = false;
        var token = run.Token;

        ShowLoader = true;
        try
        {
            // The SEO client refuses private addresses, follows a few redirects only and has a timeout (SeoHttp).
            var httpClient = HttpClientFactory.CreateClient(SeoHttp.ClientName);
            var doc = new HtmlDocument();
            doc.LoadHtml(await httpClient.GetStringAsync(pageUri, token));

            var seoChecks = ExtensionManager.GetInstances<ISeoCheck>(true);
            foreach (var seoCheck in seoChecks.OrderBy(x => x.Value.SortOrder).ThenBy(x => x.Value.Name))
            {
                token.ThrowIfCancellationRequested();
                results.Add(await RunCheckAsync(seoCheck.Value, pageUri!.ToString(), doc, token));
                // Each result shows as it arrives
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            if (ReferenceEquals(_run, run))
            {
                ErrorMessage = _stopped
                    ? "The checks were stopped."
                    : $"The checks took longer than {RunTimeLimit.TotalMinutes:0} minutes and were stopped.";
            }
        }
        catch (HttpRequestException e) when (ReferenceEquals(_run, run))
        {
            ErrorMessage = $"The page could not be loaded: {e.Message}";
        }
        catch (TaskCanceledException) when (ReferenceEquals(_run, run))
        {
            ErrorMessage = "The page did not answer in time.";
        }
        catch (Exception) when (!ReferenceEquals(_run, run))
        {
            // A run that a newer one replaced: its error is not shown
        }
        finally
        {
            if (ReferenceEquals(_run, run))
            {
                // Not a newer run's state
                ShowLoader = false;
                _stopped = false;
            }
        }
    }

    // One check that throws is shown as a failed check; the others still run (a site's own ISeoCheck included)
    private async Task<SeoCheckResult> RunCheckAsync(ISeoCheck seoCheck, string url, HtmlDocument doc,
        CancellationToken token)
    {
        try
        {
            // WaitAsync: a check that only implements the method without a token still stops being waited for
            return await seoCheck.Check(url, doc, Content!, token).WaitAsync(token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The SEO check {SeoCheck} failed on {Url}", seoCheck.GetType().FullName, url);
            var result = new SeoCheckResult(seoCheck.Name);
            result.Items.Add(new SeoCheckResultItem
            {
                Status = ZauberCMS.Core.Shared.Models.AlertType.Error,
                DefaultMessage = "This check could not be run. The details are in the site's log."
            });
            return result;
        }
    }

    private bool _stopped;

    private void StopSeoChecks()
    {
        _stopped = true;
        _run?.Cancel();
    }

    public void Dispose()
    {
        _run?.Cancel();
        _run?.Dispose();
        _run = null;
    }
}
