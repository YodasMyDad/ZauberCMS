@attribute [Route(Urls.AdminSeoPageChecker)]
@attribute [ZauberCMS.Core.Sections.Authorization.AuthorizeSection(ZauberCMS.Core.Constants.Sections.SettingsSection)]
@using ZauberCMS.Core

@layout SectionLayout

<PageTitle>@L["seo_pageCheckerTitle"]</PageTitle>


<RadzenPanel Class="rz-mx-auto">
    <SeoChecker />
</RadzenPanel>

@code {

    [CascadingParameter] protected SectionLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        Layout?.SetSection(Constants.Sections.SettingsSection);
    }
    
}