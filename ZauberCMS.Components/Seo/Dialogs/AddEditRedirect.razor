@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Seo.Models

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="Domain" Description="Optional domain to restrict the redirect to"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenDropDown TValue="Guid" @bind-Value="@SelectedDomainId" Data="@Domains" TextProperty="Text" ValueProperty="Id" Style="width: 100%;" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="From Url" Description="The address to redirect from, starting with / (the query string too, if it has one)" />
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Redirect.FromUrl" Style="width: 100%" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="Regular expression?" Description="On: the From Url is a regular expression matched against the address (path and query string). Off: the address must be exactly the From Url." />
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@IsRegex" />
        @if (IsRegex)
        {
            <div class="rz-mt-2">
                Letter case is ignored. Test the expression on <a href="https://regex101.com/" target="_blank" rel="noopener noreferrer">regex101.com</a> (.NET flavour) first.
            </div>
        }
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="To Url" Description="Url you want to redirect to" />
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Redirect.ToUrl" Style="width: 100%" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="Permanent Redirect?" Description="Do you want a permanent (301) or temporary redirect (302)?" />
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Redirect.IsPermanent" />
    </CentreColumn>
</EditorRow>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" class="rz-mt-3">
    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Icon="save" Text="Save" Click="Save"/>
</RadzenStack>

@code {

    [Parameter] public SeoRedirect Redirect { get; set; } = new();
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = null!;
    [Inject] public NotificationService NotificationService { get; set; } = null!;

    private List<DomainChoice> Domains { get; set; } = [];
    private Guid SelectedDomainId { get; set; }

    // A redirect saved before the flag existed shows what it is matched as today (ZA-116); saving makes it explicit
    private bool IsRegex { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsRegex = ZauberCMS.Core.Seo.RedirectRules.IsRegex(Redirect);
        SelectedDomainId = Redirect.DomainId ?? Guid.Empty;
        var domains = await ContentService.QueryDomainAsync(new QueryDomainParameters 
        {
            AmountPerPage = 1000
        });
        
        Domains = domains.Items
            .Where(x => !x.Url.IsNullOrWhiteSpace())
            .Select(x => new DomainChoice
        {
            Text = x.Url!,
            Id = x.Id
        }).ToList();
        
        Domains.Insert(0, new DomainChoice{Text = "Any", Id = Guid.Empty });
    }
        
    private async Task Save()
    {
        Redirect.FromUrl = Redirect.FromUrl?.Trim();
        Redirect.IsRegex = IsRegex;
        if (ValidateFromUrl() is { } problem)
        {
            NotificationService.ShowErrorNotification(problem);
            return;
        }
        
        if(Redirect.ToUrl.IsNullOrWhiteSpace())
        {
            NotificationService.ShowErrorNotification("To url must not be empty");
            return;
        }
        
        // A full http(s) address is an external target and is kept as typed; anything else becomes a local path.
        Redirect.ToUrl = ZauberCMS.Core.Seo.RedirectTarget.Normalize(Redirect.ToUrl);
        if (!ZauberCMS.Core.Seo.RedirectTarget.IsValid(Redirect.ToUrl))
        {
            NotificationService.ShowErrorNotification("To url must be a path on this site (/new-page) or a full http or https address");
            return;
        }

        // Set to null if any selected
        if (SelectedDomainId == Guid.Empty)
        {
            Redirect.DomainId = null;
        }
        else
        {
            Redirect.DomainId = SelectedDomainId;
        }
        
        await BlazoredModal.CloseAsync(ModalResult.Ok(Redirect));
    }

    private string? ValidateFromUrl()
    {
        if (string.IsNullOrWhiteSpace(Redirect.FromUrl))
        {
            return "From url must not be empty";
        }

        if (!IsRegex)
        {
            return Redirect.FromUrl.StartsWith('/') ? null : "From url must start with /";
        }

        try
        {
            ZauberCMS.Core.Seo.RedirectRules.CreateRegex(Redirect.FromUrl);
            return null;
        }
        catch (ArgumentException)
        {
            return "From url is not a valid regular expression";
        }
    }
        public class DomainChoice
    {
        public string Text { get; set; } = string.Empty;
        public Guid Id { get; set; }
    }
    
}