@using ZauberCMS.Core.Shared.Models
@using ZauberCMS.Core.Shared.Services
@using ZauberCMS.Core.Membership
@using Microsoft.AspNetCore.Http
@inject IHtmlSanitizerService SanitizerService
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusMessageClass = DisplayType switch
    {
        ResultMessageType.Error => "danger",
        ResultMessageType.Warning => "warning",
        ResultMessageType.Info => "info",
        _ => "success"
    };
    <div class="alert alert-@statusMessageClass" role="alert">
        @DisplayMessage
    </div>
}

@if (ResultMessages.Any())
{
    foreach (var successMessage in ResultMessages.SuccessMessages())
    {
        <div class="alert alert-success" role="alert">
            @SanitizerService.SanitizeToMarkup(successMessage.Message)
        </div>
    }
    foreach (var errorMessage in ResultMessages.ErrorMessages())
    {
        <div class="alert alert-danger" role="alert">
            @SanitizerService.SanitizeToMarkup(errorMessage.Message)
        </div>
    }
    foreach (var errorMessage in ResultMessages.WarningMessages())
    {
        <div class="alert alert-warning" role="alert">
            @SanitizerService.SanitizeToMarkup(errorMessage.Message)
        </div>
    }
    foreach (var errorMessage in ResultMessages.InfoMessages())
    {
        <div class="alert alert-info" role="alert">
            @SanitizerService.SanitizeToMarkup(errorMessage.Message)
        </div>
    }
}

@code {
    private string? _messageFromCookie;
    private ResultMessageType? _typeFromCookie;

    [Parameter] public string? Message { get; set; }

    /// <summary>How <see cref="Message"/> is shown. Without it, a message that starts with "Error" is an error and
    /// any other a success, as in ASP.NET's Identity template; a localised message needs it (ZA-280).</summary>
    [Parameter] public ResultMessageType? MessageType { get; set; }

    [Parameter] public List<ResultMessage> ResultMessages { get; set; } = [];
    [CascadingParameter] private HttpContext? HttpContext { get; set; } = null!;

    private string? DisplayMessage => Message ?? _messageFromCookie;

    private ResultMessageType DisplayType =>
        (Message != null ? MessageType : _typeFromCookie) ??
        (DisplayMessage?.StartsWith("Error", StringComparison.Ordinal) == true ? ResultMessageType.Error : ResultMessageType.Success);

    protected override void OnInitialized()
    {
        if (HttpContext is null)
        {
            return;
        }

        _messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (_messageFromCookie is not null)
        {
            DeleteCookie(HttpContext, IdentityRedirectManager.StatusCookieName);
        }

        // Written beside the message by RedirectToWithStatus(uri, message, type, context)
        var type = HttpContext.Request.Cookies[IdentityRedirectManager.StatusTypeCookieName];
        if (type is not null)
        {
            _typeFromCookie = Enum.TryParse<ResultMessageType>(type, out var parsed) ? parsed : null;
            DeleteCookie(HttpContext, IdentityRedirectManager.StatusTypeCookieName);
        }
    }

    // At the path both were written at: the site's path base, as IdentityRedirectManager writes them (ZA-290)
    private static void DeleteCookie(HttpContext context, string name) =>
        context.Response.Cookies.Delete(name, new CookieOptions
        {
            Path = context.Request.PathBase.HasValue ? context.Request.PathBase.ToString() : "/"
        });

}