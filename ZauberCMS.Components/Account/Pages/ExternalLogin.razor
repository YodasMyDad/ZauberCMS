@page "/Account/ExternalLogin"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.RateLimiting
@using Microsoft.Extensions.Options
@using Serilog
@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Membership.Models
@using ZauberCMS.Core.Membership
@using ZauberCMS.Core.Shared.Models
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(ZauberCMS.Core.ZauberSetup.LoginRateLimitPolicy)]

<PageTitle>@L["account_register"]</PageTitle>

<StatusMessage Message="@_message" MessageType="ResultMessageType.Error" />

@code {
    [Inject] public IdentityRedirectManager RedirectManager { get; set; } = null!;
    [Inject] public SignInManager<User> SignInManager { get; set; } = null!;
    [Inject] public UserManager<User> UserManager { get; set; } = null!;
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private const string LoginCallbackAction = "LoginCallback";

    private string? _message;
    private ExternalLoginInfo _externalLoginInfo = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;
    
    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    //private string? ProviderDisplayName => _externalLoginInfo.ProviderDisplayName;

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", L["account_externalProviderError", RemoteError], ResultMessageType.Error, HttpContext);
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", L["account_externalLoginInfoError"], ResultMessageType.Error, HttpContext);
        }

        _externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            // We should only reach this page via the login callback, so redirect back to
            // the login page if we get here some other way.
            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        // Sign in the user with this external login provider if the user already has a login.
        var result = await SignInManager.ExternalLoginSignInAsync(
            _externalLoginInfo.LoginProvider,
            _externalLoginInfo.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (result.Succeeded)
        {
            Log.Information(
                "{Name} logged in with {LoginProvider} provider.",
                _externalLoginInfo.Principal.Identity?.Name,
                _externalLoginInfo.LoginProvider);
            // Back to the page that sent the visitor here, when it is on this site (ZA-253, as the login page, ZA-201)
            RedirectManager.RedirectTo(NavigationManager.ToLocalReturnUrl(ReturnUrl));
        }
        else if (result.IsLockedOut)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", L["account_externalLoginLockedOut"], ResultMessageType.Error, HttpContext);
        }

        var provider = _externalLoginInfo.ProviderDisplayName ?? _externalLoginInfo.LoginProvider;
        _message = (await DataService.GetGlobalSettings()).AllowRegistration
            ? L["account_externalSignInFailed", provider]
            : L["account_externalSignInFailedClosed", provider];
    }
}
