@page "/Account/Login"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.RateLimiting
@using Microsoft.Extensions.Options
@using ZauberCMS.Core
@using ZauberCMS.Core.Membership
@using ZauberCMS.Core.Membership.Parameters
@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Shared.Models
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(ZauberSetup.LoginRateLimitPolicy)]

<LayoutView Layout="LayoutType">
    <PageTitle>@L["account_logIn"]</PageTitle>


    <div style="width: 100%; max-width: 700px;">
            <StatusMessage ResultMessages="@ResultMessages"/>
            @if (AuthState?.User.Identity?.IsAuthenticated != true)
            {
                <EditForm Model="LoginUserCommand" method="post" asp-route-returnUrl="@ReturnUrl" OnValidSubmit="LoginUser" FormName="login">
                    <DataAnnotationsValidator/>
                    <h3>@L["account_logInHeading"]</h3>

                    <ValidationSummary class="text-danger" role="alert"/>
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="LoginUserCommand!.Email" type="email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com"/>
                        <label for="email" class="form-label">@L["general_email"]</label>
                        <ValidationMessage For="() => LoginUserCommand.Email" class="text-danger"/>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText type="password" @bind-Value="LoginUserCommand.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["general_password"]"/>
                        <label for="password" class="form-label">@L["general_password"]</label>
                        <ValidationMessage For="() => LoginUserCommand.Password" class="text-danger"/>
                    </div>
                    <div class="checkbox mb-3">
                        <label class="form-label">
                            <InputCheckbox @bind-Value="LoginUserCommand.RememberMe" class="darker-border-checkbox form-check-input"/>
                            @L["account_rememberMe"]
                        </label>
                    </div>
                    <div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@L["account_logIn"]</button>
                    </div>
                    <div style="padding-top: 10px;">
                        <p>
                            <a href="@NavigationManager.ToSiteUrl(Urls.Account.ForgotPassword)">@L["account_forgotPassword"]</a>
                        </p>
                        @if (RegistrationOpen)
                        {
                            <p>
                                <a href="@(NavigationManager.GetUriWithQueryParameters(NavigationManager.ToSiteUrl(Urls.Account.Register), new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">@L["account_registerAsNewUser"]</a>
                            </p>
                        }
                    </div>
                </EditForm>
                <ExternalLoginPicker/>
            }
            else
            {
                <p><a href="@NavigationManager.ToSiteUrl(Urls.ApiLogout)">@L["account_logOutHere"]</a></p>
            }

    </div>

</LayoutView>

@code {
    [Inject] public IdentityRedirectManager RedirectManager { get; set; } = null!;
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    [SupplyParameterFromForm] private LoginUserParameters? LoginUserCommand { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private List<ResultMessage> ResultMessages { get; set; } = [];
    private Type LayoutType { get; set; } = null!;
    private AuthenticationState? AuthState { get; set; }
    private bool RegistrationOpen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        LoginUserCommand ??= new();
        RegistrationOpen = (await DataService.GetGlobalSettings()).AllowRegistration;
        var allLayouts = ExtensionManager.GetImplementations<IAccountLayout>(true);
        if (allLayouts.TryGetValue(Settings.Value.Identity.AccountLayout!, out var accountLayout))
        {
            LayoutType = accountLayout;
        }

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState?.User.Identity?.IsAuthenticated == true)
        {
            ResultMessages.Add(new ResultMessage{Message = L["account_alreadyLoggedIn"], MessageType = ResultMessageType.Warning});
        }
    }

    public async Task LoginUser(EditContext editContext)
    {
        if (editContext.Validate())
        {
            // Back to the page that sent the visitor here, when it is on this site; it was never passed on (ZA-201)
            LoginUserCommand!.ReturnUrl = NavigationManager.ToLocalReturnUrl(ReturnUrl);
            var result = await MembershipService.LoginUserAsync(LoginUserCommand!);

            if (result.Messages.ErrorMessages().Any() == false && result.Success)
            {
                RedirectManager.RedirectTo(result.NavigateToUrl);
            }

            ResultMessages = result.Messages;
        }
    }

}