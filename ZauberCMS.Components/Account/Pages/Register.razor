@page "/Account/Register"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.RateLimiting
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using ZauberCMS.Core
@using ZauberCMS.Core.Extensions
@using ZauberCMS.Core.Membership
@using ZauberCMS.Core.Membership.Parameters
@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Providers
@using ZauberCMS.Core.Security.Interfaces
@using ZauberCMS.Core.Security.Models
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Shared.Models
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(ZauberSetup.RegisterRateLimitPolicy)]

<LayoutView Layout="LayoutType">
    @if (!RegistrationOpen)
    {
        @* Registration is turned off (GlobalSettings.AllowRegistration): this address does not exist *@
        <PageTitle>@L["account_pageNotFound"]</PageTitle>
        @if (NotFoundType != null)
        {
            <DynamicComponent Type="NotFoundType"/>
        }
        else
        {
            <h3>@L["account_pageNotFound"]</h3>
        }
    }
    else
    {
        <PageTitle>@L["account_register"]</PageTitle>

        <div style="width: 100%; max-width: 700px;">
            <StatusMessage ResultMessages="@ResultMessages"/>
            @if (AuthState?.User.Identity?.IsAuthenticated != true)
            {
                <EditForm Model="RegisterUserCommand" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="RegisterUser" FormName="register" style="width: 100%;">
                    <DataAnnotationsValidator/>
                    <h3>@L["account_createAccount"]</h3>
                    <ValidationSummary class="text-danger" role="alert"/>
                    <div class="form-floating mb-3">
                        <InputText id="username" @bind-Value="RegisterUserCommand!.Username" class="form-control" autocomplete="nickname" aria-required="true" placeholder="@L["general_username"]"/>
                        <label for="username">@L["general_username"]</label>
                        <ValidationMessage For="() => RegisterUserCommand.Username" class="text-danger"/>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText id="email" @bind-Value="RegisterUserCommand.Email" type="email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                        <label for="email">@L["general_email"]</label>
                        <ValidationMessage For="() => RegisterUserCommand.Email" class="text-danger"/>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText id="password" type="password" @bind-Value="RegisterUserCommand.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["general_password"]"/>
                        <label for="password">@L["general_password"]</label>
                        <ValidationMessage For="() => RegisterUserCommand.Password" class="text-danger"/>
                    </div>
                    <FormProtectionFields Token="@FormToken"/>
                    @if (CaptchaProvider != null)
                    {
                        <div class="mb-3">
                            <DynamicComponent Type="CaptchaProvider.Component"/>
                        </div>
                    }
                    <button type="submit" class="w-100 btn btn-lg btn-primary">@L["account_register"]</button>
                </EditForm>
                <ExternalLoginPicker/>
            }
        </div>
    }
</LayoutView>

@code {
    [SupplyParameterFromForm] public RegisterUserParameters? RegisterUserCommand { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Inject] public IdentityRedirectManager RedirectManager { get; set; } = null!;
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    [Inject] public IFormProtectionService FormProtection { get; set; } = null!;
    [Inject] public ProviderService ProviderService { get; set; } = null!;
    [Inject] public ILogger<Register> Logger { get; set; } = null!;

    private List<ResultMessage> ResultMessages { get; set; } = [];
    private Type LayoutType { get; set; } = null!;
    private AuthenticationState? AuthState { get; set; }
    private bool RegistrationOpen { get; set; }
    private Type? NotFoundType { get; set; }
    private ICaptchaProvider? CaptchaProvider { get; set; }
    private string? FormToken { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var allLayouts = ExtensionManager.GetImplementations<IAccountLayout>(true);
        if (allLayouts.TryGetValue(Settings.Value.Identity.AccountLayout!, out var accountLayout))
        {
            LayoutType = accountLayout;
        }

        RegistrationOpen = (await DataService.GetGlobalSettings()).AllowRegistration;
        if (!RegistrationOpen)
        {
            // Set as the response starts: a 404 set now would be sent without the not-found view's HTML (ZA-164)
            HttpContext?.SetStatusCodeWhenResponseStarts(StatusCodes.Status404NotFound);

            var notFound = Settings.Value.NotFoundComponent;
            if (notFound != null && ExtensionManager.GetImplementations<IContentView>(true).TryGetValue(notFound, out var view))
            {
                NotFoundType = view;
            }

            return;
        }

        CaptchaProvider = ProviderService.CaptchaProvider;

        // Shown again after a refused post: keep the token that came with it, so the time the visitor has
        // already spent on the form still counts
        if (HttpContext != null && HttpMethods.IsPost(HttpContext.Request.Method) && HttpContext.Request.HasFormContentType)
        {
            var posted = HttpContext.Request.Form[FormProtection.TokenFieldName].ToString();
            if (FormProtection.Validate(posted, null) is FormProtectionResult.Passed or FormProtectionResult.TooFast)
            {
                FormToken = posted;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        RegisterUserCommand ??= new();
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (RegistrationOpen && AuthState?.User.Identity?.IsAuthenticated == true && ResultMessages.Count == 0)
        {
            ResultMessages.Add(new ResultMessage{Message = L["account_alreadyLoggedIn"], MessageType = ResultMessageType.Warning});
        }
    }

    public async Task RegisterUser(EditContext editContext)
    {
        if (!RegistrationOpen || HttpContext == null || !editContext.Validate())
        {
            return;
        }

        // A script, not a person? (the hidden field, and how quickly the form came back)
        var protection = FormProtection.Validate(HttpContext);
        if (protection != FormProtectionResult.Passed)
        {
            Logger.LogInformation("Registration from {RemoteIp} refused by form protection: {Reason}",
                HttpContext.Connection.RemoteIpAddress, protection);
            ResultMessages =
            [
                new ResultMessage(protection switch
                {
                    FormProtectionResult.TooFast => L["account_formTooFast"].Value,
                    FormProtectionResult.Expired => L["account_formExpired"].Value,
                    FormProtectionResult.AlreadyUsed => L["account_formAlreadySent"].Value,
                    _ => L["account_registerFailed"].Value
                }, ResultMessageType.Error)
            ];
            return;
        }

        // One token, one post (ZA-150): a script cannot fetch a token once and send it again and again. If this
        // post is refused further on, the form comes back with a new token.
        var token = HttpContext.Request.Form[FormProtection.TokenFieldName].ToString();
        FormToken = null;
        if (!FormProtection.TryUseToken(token))
        {
            ResultMessages = [new ResultMessage(L["account_formAlreadySent"], ResultMessageType.Error)];
            return;
        }

        if (CaptchaProvider != null)
        {
            bool verified;
            try
            {
                verified = await CaptchaProvider.VerifyAsync(HttpContext, HttpContext.RequestAborted);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogError(ex, "CAPTCHA provider {Provider} failed", CaptchaProvider.GetType().FullName);
                verified = false;
            }

            if (!verified)
            {
                ResultMessages = [new ResultMessage(L["account_captchaFailed"], ResultMessageType.Error)];
                return;
            }
        }

        RegisterUserCommand!.AutoLogin = true;
        // Back to the page that sent the visitor here, when it is on this site: the address the page was opened
        // with, not one posted in the form (ZA-253, as the login page, ZA-201)
        RegisterUserCommand.ReturnUrl = NavigationManager.ToLocalReturnUrl(ReturnUrl);
        var result = await MembershipService.RegisterUserAsync(RegisterUserCommand);

        if (result.Success)
        {
            if (!result.NavigateToUrl.IsNullOrWhiteSpace())
            {
                RedirectManager.RedirectTo(result.NavigateToUrl);
            }

            ResultMessages = result.Messages.SuccessMessages().ToList();
        }
        else
        {
            ResultMessages = result.Messages.ErrorMessages().ToList();
        }
    }

}
