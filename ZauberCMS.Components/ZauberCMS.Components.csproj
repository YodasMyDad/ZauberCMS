<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>ZauberCMS.Components</PackageId>
        <Description>ZauberCMS components package</Description>
        <!-- The resources in this assembly are English (CA1824); a translation ships as a satellite assembly. -->
        <NeutralLanguage>en</NeutralLanguage>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <StaticWebAssetBasePath>_content/$(PackageId)</StaticWebAssetBasePath>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BlazorMonaco" />
        <PackageReference Include="Humanizer" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.Extensions.Localization" />
        <PackageReference Include="Radzen.Blazor" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="ImageResize" />
        <PackageReference Include="TinyMCE.Blazor" />
        <PackageReference Include="ZauberCMS.RTE" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ZauberCMS.Core\ZauberCMS.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ZauberCMS.Components.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\SharedResource.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>SharedResource.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\SharedResource.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>SharedResource.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <Content Remove="..\..\..\Users\LeeMessenger\.nuget\packages\zaubercms.rte\1.0.0-beta9\contentFiles\any\net9.0\package-lock.json" />
      <Content Remove="..\..\..\Users\LeeMessenger\.nuget\packages\zaubercms.rte\1.0.0-beta9\contentFiles\any\net9.0\package.json" />
    </ItemGroup>

    <ItemGroup>
      <UpToDateCheckInput Remove="Editors\Settings\RichTextEditor\InsertMedia.razor" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Editors\Dialogs\RichTextEditor\InsertMedia.razor" />
    </ItemGroup>

</Project>
