@using Microsoft.AspNetCore.Http
@using ZauberCMS.Core.Extensions
@implements ZauberCMS.Core.Content.Interfaces.IContentView
@layout BlankLayout

<PageTitle>@L["account_notFoundTitle"]</PageTitle>

<div class="text-center">
    <h3>@L["account_notFound"]</h3>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    protected override void OnInitialized()
    {
        // EntryPage already sets 404 for any not-found view; this covers a page that shows this view itself. Set as
        // the response starts: a 404 set now would be sent without this HTML (ZA-164)
        HttpContext?.SetStatusCodeWhenResponseStarts(StatusCodes.Status404NotFound);
    }

    [Parameter] public Content? Content { get; set; }
    [Parameter] public Dictionary<string, string>? LanguageKeys { get; set; }
}
