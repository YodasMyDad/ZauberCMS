@implements ZauberCMS.Core.Content.Interfaces.IContentView
@layout BlankLayout
<PageTitle>@L["account_newInstall"]</PageTitle>

<div class="full-page">
    <div class="centered-div text-center">
        <ZauberCMS.Components.Shared.ZauberLogo Styles="height: 100px; margin-bottom: 20px" />
        <p>@L["account_newSiteNoContent"] <a href="/admin" data-enhance-nav="false">@L["account_newSiteGoToAdmin"]</a></p>
        <p>@L["account_newSiteDocumentation"] <a href="https://aptitude.gitbook.io/zaubercms" target="_blank">@L["account_newSiteDocumentationLink"]</a></p>
    </div>
</div>

@code {
    [Parameter] public Content? Content { get; set; }
    [Parameter] public Dictionary<string, string>? LanguageKeys { get; set; }
}



