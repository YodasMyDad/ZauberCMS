@implements ZauberCMS.Core.Content.Interfaces.IContentView
@layout BlankLayout

<PageTitle>@L["account_missingView"]</PageTitle>

<div class="text-center">
    <h3>@L["account_missingView"]</h3>
    <p>@(L["account_missingViewDetail", Content?.Name ?? string.Empty])</p>
</div>

@code {
    [Parameter] public Content? Content { get; set; }
    [Parameter] public Dictionary<string, string>? LanguageKeys { get; set; }
}