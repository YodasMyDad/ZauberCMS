@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using ZauberCMS.Core.Settings
@implements ZauberCMS.Core.Membership.Interfaces.IAccountLayout

<HeadContent>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />
    <link rel="stylesheet" href="_content/ZauberCMS.Components/ZauberCMS.Components.bundle.scp.css" />
</HeadContent>


<div style="display: flex; justify-content: center; align-items: center; height: 100vh; width: 100vw; overflow: hidden;">
    @Body
    <div id="blazor-error-ui" style="display: none" data-nosnippet>
        @L["account_unhandledError"]
        <a href="." class="reload">@L["account_reload"]</a>
        <span class="dismiss">🗙</span>
    </div>
</div>

@code
{
    // Kept for sites that read it from a layout of their own; this layout no longer uses it
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;

    // The account pages and the fallback site pages are site-facing: they are in the request's culture (the site's
    // languages, UseRequestLocalization; a content page's language for a page under content), not the admin's
    // (Roadmap D95). The layout sets no culture of its own: it applied the admin's in OnInitialized, which said the
    // opposite and reached nothing rendered (a culture set in a lifecycle method stays in that method).
}