@using System.Diagnostics.CodeAnalysis
@using Microsoft.Extensions.Logging

@inject IJSRuntime JS
@inject ILogger<SortableList<T>> Logger

@typeparam T
@implements IAsyncDisposable

<div id="@Id">
    @foreach (var item in Items)
    {
        @if (SortableItemTemplate is not null)
        {
            @SortableItemTemplate(item)
        }
    }
</div>

@code {

    [Parameter]
    public RenderFragment<T>? SortableItemTemplate { get; set; }

    [Parameter, AllowNull]
    public List<T> Items { get; set; }

    [Parameter]
    public EventCallback<(int oldIndex, int newIndex)> OnUpdate { get; set; }

    [Parameter]
    public EventCallback<(int oldIndex, int newIndex)> OnRemove { get; set; }

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Group { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string? Pull { get; set; }

    [Parameter]
    public bool Put { get; set; } = true;

    [Parameter]
    public bool Sort { get; set; } = true;

    [Parameter]
    public string Handle { get; set; } = string.Empty;

    [Parameter]
    public string? Filter { get; set; }

    [Parameter]
    public bool ForceFallback { get; set; } = true;
    
    [Parameter]
    public bool IgnoreDomChanges { get; set; }

    private DotNetObjectReference<SortableList<T>>? selfReference;
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ZauberCMS.Components/Shared/SortableList.razor.js");
            if (_disposed)
            {
                // Disposed while the script loaded: nothing will dispose this module later
                await DisposeModuleAsync(module);
                return;
            }

            _module = module;
            await _module.InvokeVoidAsync("init", Id, Group, Pull, Put, Sort, Handle, Filter, selfReference, ForceFallback, IgnoreDomChanges);
        }
    }

    // Return the callback's task, so the caller's work (a save after a sort) is awaited and its errors are seen (ZA-112)
    [JSInvokable]
    public Task OnUpdateJS(int oldIndex, int newIndex) => InvokeLogged(OnUpdate, oldIndex, newIndex);

    [JSInvokable]
    public Task OnRemoveJS(int oldIndex, int newIndex) => InvokeLogged(OnRemove, oldIndex, newIndex);

    // An error in the caller's handler is logged here (the browser only sees a rejected promise) and still returned
    private async Task InvokeLogged(EventCallback<(int oldIndex, int newIndex)> callback, int oldIndex, int newIndex)
    {
        try
        {
            await callback.InvokeAsync((oldIndex, newIndex));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sortable list {Id}: moving item {OldIndex} to {NewIndex} failed", Id, oldIndex, newIndex);
            throw;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await DisposeModuleAsync(_module);
                _module = null;
            }
        }
        finally
        {
            // Always released, whatever the module dispose did (ZA-112)
            selfReference?.Dispose();
            selfReference = null;
        }
    }

    private static async ValueTask DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the module with it
        }
    }
}
