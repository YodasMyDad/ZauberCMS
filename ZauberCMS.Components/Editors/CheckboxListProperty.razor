@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Components.Editors.Settings
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty
@inherits ListPropertyBaseComponent

@if (SettingsModel.MaxAmount > 0)
{
    <div>
        <RadzenText TextStyle="TextStyle.Caption">@L["editors_maxAllowed", SettingsModel.MaxAmount]</RadzenText>
    </div>
}

<RadzenListBox Data="@SettingsModel.Items" 
               Value="@SelectedValues" 
               FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
               FilterOperator="StringFilterOperator.StartsWith"
               AllowFiltering="true"
               TextProperty="Name"
               ValueProperty="Value"
               Multiple="true"
               AllowClear="true"
               Change="@(args => Changed(args))"
               Placeholder="@L["general_search"]" 
               Style="width: 100%; max-height: 400px" />
                    
@code {
    
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public CheckboxListProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public CheckboxListProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as before v5 (a subclass or a site may rename the editor); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_checkboxList"].Value; set => _name = value; }
    public string Alias { get; set; } = "ZauberCMS.CheckboxList";
    public string Icon { get; set; } = "list";
    public string Description { get => _description ?? _text["editors_checkboxListInfo"].Value; set => _description = value; }
    public Type? SettingsComponent { get; set; } = typeof(ListPropertySettings);
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }
    
    private async Task Changed(object args)
    {
        var list = args as IEnumerable<string>;
        await OnChange(list!, true);
    }
    
}