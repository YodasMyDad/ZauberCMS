@using System.Text.Json
@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Core.Seo.Models
@using ZauberCMS.Core.Shared.Models
@using ZauberCMS.Components.Seo
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty

<RadzenTabs TabPosition="TabPosition.Left">
    <Tabs>
        <RadzenTabsItem Text="@L["editors_seoFields"]">
            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoPageTitle"]"
                                  Description="@L["editors_seoPageTitleInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenTextBox Change="@(async () => await NotifyValueChanged())"
                                   @bind-Value="@Meta.PageTitle"
                                   class="form-control w-full"
                                   MaxLength="80"/>
                    @if (!string.IsNullOrEmpty(Meta.PageTitle) && Meta.PageTitle.Length > 60)
                    {
                        <div class="mt-1">
                            <TailwindAlert Type="AlertType.Warning" Title="@L["editors_seoPageTitleLength", Meta.PageTitle.Length]" />
                        </div>
                    }

                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoMetaDescription"]"
                                  Description="@L["editors_seoMetaDescriptionInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenTextArea
                        oninput="event.target.style.height = Math.max(event.target.clientHeight, event.target.scrollHeight) + 'px';"
                        Change="@(async () => await NotifyValueChanged())"
                        @bind-Value="@Meta.MetaDescription"
                        class="form-control w-full" MaxLength="160"/>
                    @if (!string.IsNullOrEmpty(Meta.MetaDescription) && Meta.MetaDescription.Length > 160)
                    {
                        <div class="mt-1">
                            <TailwindAlert Type="AlertType.Warning" Title="@L["editors_seoMetaDescriptionLength", Meta.MetaDescription.Length]" />
                        </div>
                    }
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoOpenGraphImage"]"
                                  Description="@L["editors_seoOpenGraphImageInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <MediaPickerProperty
                        Value="@(Meta.OpenGraphImage != null ? Meta.OpenGraphImage.ToString() : string.Empty)"
                        Settings="@(JsonSerializer.Serialize(new MediaPickerSettings { MaxAllowed = 1 }))"
                        ValueChanged="@(e => SetOpenGraphMedia(e))"/>
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoHideFromSearchEngines"]"
                                  Description="@L["editors_seoHideFromSearchEnginesInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenSwitch @bind-Value="@Meta.HideFromSearchEngines"
                                  Change="@(async () => await NotifyValueChanged())"
                                  InputAttributes="@(new Dictionary<string, object> { { "aria-label", L["editors_seoHideFromSearchEngines"].Value } })"/>
                </CentreColumn>
            </EditorRow>
        </RadzenTabsItem>
        <RadzenTabsItem Text="@L["editors_seoSitemap"]">
            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoExcludeFromSitemap"]"
                                  Description="@L["editors_seoExcludeFromSitemapInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenSwitch @bind-Value="@Meta.ExcludeFromSitemap"
                                  Change="@(async () => await NotifyValueChanged())"
                                  InputAttributes="@(new Dictionary<string, object> { { "aria-label", L["editors_seoExcludeFromSitemap"].Value } })"/>
                </CentreColumn>
            </EditorRow>
            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoChangeFrequency"]"
                                  Description="@L["editors_seoChangeFrequencyInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenDropDown
                        @bind-Value="Meta.ChangeFrequency"
                        Data="ChangeFrequencyOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Style="width: 100%;" />
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editors_seoPriority"]"
                                  Description="@L["editors_seoPriorityInfo"]"/>
                </LeftColumn>
                <CentreColumn>
                    <RadzenNumeric Style="width: 100%;" TValue="double" @bind-Value="@Meta.Priority" />
                </CentreColumn>
            </EditorRow>
        </RadzenTabsItem>
        <RadzenTabsItem Text="@L["editors_seoChecker"]">
            <SeoChecker Content="Content" FullUrl="@FullUrl" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public SeoProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public SeoProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as every built-in editor's (D120: a subclass or a site may rename it); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_seo"].Value; set => _name = value; }
    public string Alias => "ZauberCMS.Seo";
    public string Description { get => _description ?? _text["editors_seoInfo"].Value; set => _description = value; }
    public string Icon => "show_chart";
    public Type? SettingsComponent { get; set; }
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; } = true;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Settings { get; set; } = string.Empty;
    [Parameter] public Content? Content { get; set; }
    
    [CascadingParameter] public IModalService? ModalService { get; set; }
    
    private Meta Meta { get; set; } = new();
    private string? FullUrl { get; set; }
    
    public SeoSitemapChangeFrequency[] ChangeFrequencies { get; set; } =
        Enum.GetValues(typeof(SeoSitemapChangeFrequency)).Cast<SeoSitemapChangeFrequency>().ToArray();

    // The change frequencies with their names in the admin's language; the value stays the frequency
    private List<ChangeFrequencyOption> ChangeFrequencyOptions { get; set; } = [];

    private sealed record ChangeFrequencyOption(SeoSitemapChangeFrequency Value, string Text);

    private string ChangeFrequencyText(SeoSitemapChangeFrequency frequency) => frequency switch
    {
        SeoSitemapChangeFrequency.Always => L["editors_changeFrequencyAlways"],
        SeoSitemapChangeFrequency.Hourly => L["editors_changeFrequencyHourly"],
        SeoSitemapChangeFrequency.Daily => L["editors_changeFrequencyDaily"],
        SeoSitemapChangeFrequency.Weekly => L["editors_changeFrequencyWeekly"],
        SeoSitemapChangeFrequency.Monthly => L["editors_changeFrequencyMonthly"],
        SeoSitemapChangeFrequency.Yearly => L["editors_changeFrequencyYearly"],
        SeoSitemapChangeFrequency.Never => L["editors_changeFrequencyNever"],
        _ => frequency.ToString()
    };

    
    private async Task SetOpenGraphMedia(string? e)
    {
        // The picker stores a JSON array of ids (Roadmap D30); this one holds at most one
        var ids = e.ToPickerIds();
        Meta.OpenGraphImage = ids.Count == 0 ? null : ids[0];

        await NotifyValueChanged();
    }
    
    protected override void OnInitialized()
    {
        ChangeFrequencyOptions = ChangeFrequencies.Select(f => new ChangeFrequencyOption(f, ChangeFrequencyText(f))).ToList();
        if (!Value.IsNullOrWhiteSpace())
        {
            Meta = JsonSerializer.Deserialize<Meta>(Value) ?? new Meta();
        }

        var currentUri = new Uri(NavigationManager.BaseUri);
        FullUrl = $"{currentUri}{Content?.Url}";

        //SettingsModel = Settings.FromJson<MediaPickerSettings>();
    }

    private async Task NotifyValueChanged()
    {
        // Serialize Meta object to JSON and notify parent
        var jsonValue = JsonSerializer.Serialize(Meta);
        await ValueChanged.InvokeAsync(jsonValue);
    }

}