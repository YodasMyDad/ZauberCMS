@using System.Text.Json
@using Microsoft.Extensions.Logging
@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Components.Editors.Settings
@using ZauberCMS.Components.Editors.Components
@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Content.Mapping
@using ZauberCMS.Core.Content.Models
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty

<div class="block-list-editor @(IsDragging ? "dragging-active" : "")">
    @if (State.Items.Any())
    {
        <!-- Top drop zone -->
        <BlockListDropZone Index="0"
                          OnInsert="HandleInsert"
                          OnDrop="HandleDropAtIndex"
                          IsDragging="@IsDragging" />

        @for (var i = 0; i < State.Items.Count; i++)
        {
            var item = State.Items[i];
            var itemIndex = i; // Capture for closures

            @if (State.ContentTypes.TryGetValue(item.ContentTypeId, out var contentType))
            {
                <BlockListItem @key="item.Id"
                              Content="@item"
                              PreviewContent="@GetPreviewContent(item)"
                              ContentType="@contentType"
                              Index="@itemIndex"
                              Stylesheets="@SettingsModel.Stylesheets"
                              OnEdit="HandleEdit"
                              OnDelete="HandleDelete"
                              OnDropOnItem="HandleDropOnItem"
                              OnDragStart="HandleDragStart"
                              OnDragEnd="HandleDragEnd" />

                <!-- Drop zone between items -->
                @if (itemIndex < State.Items.Count - 1)
                {
                    <BlockListDropZone Index="@(itemIndex + 1)"
                                      OnInsert="HandleInsert"
                                      OnDrop="HandleDropAtIndex"
                                      IsDragging="@IsDragging" />
                }
            }
        }
    }

    <!-- Add New Block Button -->
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem" class="rz-pt-3"
                 JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
        <RadzenButton Icon="add" Size="ButtonSize.Medium"
                     Click="@(() => HandleInsert(State.Items.Count))"
                     class="rz-border-radius-10" aria-label="Add new block" />
        <div class="text-sm">Add New Block</div>
    </RadzenStack>
</div>

@code {
    // IContentProperty implementation
    public string Name { get; set; } = "Block List Editor";
    public string Alias { get; set; } = "ZauberCMS.BlockListEditor";
    public string Description { get; set; } = "Creates a list of content blocks with drag-and-drop ordering";
    public string Icon { get; set; } = "format_align_justify";
    public Type? SettingsComponent { get; set; } = typeof(BlockListEditorSettings);
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }

    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public string? Settings { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Content? Content { get; set; }
    [Parameter] public string? PropertyAlias { get; set; }

    /// <summary>The scope of the content editor this list sits in; block edits go into child scopes of it.</summary>
    [CascadingParameter] public ContentEditScope? Scope { get; set; }
    [CascadingParameter] public IModalService? ModalService { get; set; }
    [Inject] public NotificationService NotificationService { get; set; } = null!;
    [Inject] public DialogService DialogService { get; set; } = null!;
    [Inject] public ILogger<BlockListEditorProperty> Logger { get; set; } = null!;

    private BlockListState State { get; set; } = new();
    private BlockListEditorSettingsModel SettingsModel { get; set; } = new();
    private bool IsDragging { get; set; }
    private int? DragSourceIndex { get; set; }
    private bool _typesLoaded;

    // What the list was loaded for: a new value from outside (a reload after a save) or a new scope loads it again
    private string? _loadedValue;
    private ContentEditScope? _loadedScope;

    // Preview copies (with the unsaved blocks inside each block), rebuilt when the list changes
    private readonly Dictionary<Guid, Content> _previews = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!_typesLoaded)
        {
            SettingsModel = Settings.FromJson<BlockListEditorSettingsModel>();
            var contentTypes = await ContentService.QueryContentTypesAsync(new QueryContentTypesParameters
            {
                AmountPerPage = 300,
                OnlyElementTypes = true
            });
            State = State with { ContentTypes = contentTypes.Items.ToDictionary(x => x.Id, x => x) };
            _typesLoaded = true;
        }

        if (_loadedValue == Value && ReferenceEquals(_loadedScope, Scope)) return;
        _loadedValue = Value;
        _loadedScope = Scope;
        await LoadContentItems();
    }

    private async Task LoadContentItems()
    {
        List<Guid> contentIds;
        try
        {
            // Defensive .Distinct() — duplicate Guids in the JSON would later throw at the
            // ToDictionary(x => x.Id) below.
            contentIds = Value.IsNullOrWhiteSpace()
                ? []
                : (JsonSerializer.Deserialize<List<Guid>>(Value!) ?? [])
                    .Where(id => id != Guid.Empty)
                    .Distinct()
                    .ToList();
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex,
                "Failed to deserialize BlockListEditor value for property {Alias} on content {ContentId}",
                PropertyAlias, Content?.Id);
            contentIds = [];
        }

        // Blocks edited in this edit and not saved yet come from the scope; the rest from the database
        var dbIdsNeeded = contentIds.Where(id => Scope?.GetDraft(id) == null).ToList();
        var dbItems = new Dictionary<Guid, Content>();
        if (dbIdsNeeded.Count > 0)
        {
            var contentResult = await ContentService.QueryContentAsync(new QueryContentParameters
            {
                Ids = dbIdsNeeded,
                AmountPerPage = Math.Max(dbIdsNeeded.Count, 1),
                NestedFilter = BaseQueryContentParameters.NestedContentFilter.Only,
                IncludeUnpublished = true,
                Cached = false
            });

            // A block with a pending draft ("Save only" of its page) is edited from the draft. On a copy, so a
            // cached query result is never changed.
            dbItems = contentResult.Items.ToDictionary(x => x.Id, x => x.UnpublishedContent == null
                ? x
                : x.UnpublishedContent.JsonContent.MapBlockDraftTo(x.MapToNew()));
        }

        var orderedItems = contentIds
            .Select(id => Scope?.GetDraft(id) ?? dbItems.GetValueOrDefault(id))
            .Where(c => c != null)
            .Cast<Content>()
            .ToList();

        foreach (var item in orderedItems)
        {
            if (State.ContentTypes.TryGetValue(item.ContentTypeId, out var contentType))
            {
                item.ContentTypeAlias = contentType.Alias;
            }
        }

        var missingIds = contentIds.Except(orderedItems.Select(x => x.Id)).ToList();
        if (missingIds.Count > 0)
        {
            Logger.LogWarning(
                "BlockListEditor on content {ContentId} (property {Alias}) references {MissingCount} content id(s) that no longer exist: {MissingIds}",
                Content?.Id, PropertyAlias, missingIds.Count, string.Join(", ", missingIds));
        }

        State = State with { Items = orderedItems };
        _previews.Clear();
    }

    private Content GetPreviewContent(Content item)
    {
        if (Scope == null) return item;
        if (!_previews.TryGetValue(item.Id, out var preview))
        {
            preview = Scope.CreatePreviewCopy(item);
            _previews[item.Id] = preview;
        }

        return preview;
    }

    private async Task HandleInsert(int insertIndex)
    {
        await OpenContentEditor(null, insertIndex);
    }

    private async Task HandleEdit(int index)
    {
        if (index >= 0 && index < State.Items.Count)
        {
            await OpenContentEditor(State.Items[index], null);
        }
    }

    private async Task HandleDelete(int index)
    {
        if (index < 0 || index >= State.Items.Count) return;

        var content = State.Items[index];
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this block?",
            "Delete Block",
            new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }
        );

        if (confirmed == true)
        {
            // Only the list changes; the save deletes the block (and the blocks inside it) once nothing lists it
            State = State.DeleteItem(content.Id);
            await NotifyChanges();
        }
    }

    private void HandleDragStart(int sourceIndex)
    {
        IsDragging = true;
        DragSourceIndex = sourceIndex;
        StateHasChanged();
    }

    private void HandleDragEnd()
    {
        IsDragging = false;
        DragSourceIndex = null;
        StateHasChanged();
    }

    private async Task HandleDropOnItem(int targetIndex)
    {
        // Snapshot the source index in case another event mutates DragSourceIndex while we await.
        var sourceIndex = DragSourceIndex;
        DragSourceIndex = null;
        if (sourceIndex.HasValue && sourceIndex.Value != targetIndex)
        {
            State = State.ReorderItems(sourceIndex.Value, targetIndex);
            await NotifyChanges();
        }
    }

    private async Task HandleDropAtIndex(int targetIndex)
    {
        // Snapshot to avoid races with concurrent drag/drop events
        var sourceIndex = DragSourceIndex;
        DragSourceIndex = null;
        if (sourceIndex.HasValue)
        {
            // Adjust target index if dragging down (because drop zone index is +1 of the item before it)
            var adjustedTarget = sourceIndex.Value < targetIndex ? targetIndex - 1 : targetIndex;

            if (sourceIndex.Value != adjustedTarget)
            {
                State = State.ReorderItems(sourceIndex.Value, adjustedTarget);
                await NotifyChanges();
            }
        }
    }

    private async Task OpenContentEditor(Content? contentToEdit, int? insertAtIndex)
    {
        if (Content == null || Scope == null || ModalService == null)
        {
            Logger.LogWarning("The block list editor needs its content, the editor's edit scope and the modal service to open a block");
            return;
        }

        // The block's edits, and those of any block opened inside it, stay in this scope until its editor is saved
        var blockScope = Scope.BeginChild();
        var contentParams = new Dictionary<string, object>
        {
            { nameof(ContentEditor.IsBlockList), true },
            { nameof(ContentEditor.NestedParentId), Content.Id },
            { nameof(ContentEditor.EditScope), blockScope }
        };

        // Filter allowed element types if configured
        if (SettingsModel.AllowedElementTypeIds.Any())
        {
            contentParams.Add(nameof(ContentEditor.AllowedElementTypeIds), SettingsModel.AllowedElementTypeIds.ToList());
        }

        if (contentToEdit != null)
        {
            contentParams.Add(nameof(ContentEditor.Content), contentToEdit);
        }
        else
        {
            contentParams.Add(nameof(ContentEditor.DefaultName), $"Block {(State.Items.Count + 1).ToWords()}");
        }

        ModalResult result;
        try
        {
            result = await ModalService.OpenSidePanel<ContentEditor>("Edit Content Block", contentParams).Result;
        }
        catch
        {
            blockScope.Rollback();
            throw;
        }

        if (result is not { Confirmed: true, Data: ZauberCMS.Core.Content.Models.Content savedBlock })
        {
            // Cancelled or closed: nothing done in that editor is kept
            blockScope.Rollback();
            return;
        }

        if (blockScope.Parent != Scope || Scope.IsClosed)
        {
            // The page was reloaded while the block was open (someone else saved it): its edit has nowhere to go
            blockScope.Rollback();
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Block changes not kept",
                Detail = "The page was reloaded while the block was open. Open the block again and redo the changes.",
                Duration = 10000
            });
            return;
        }

        blockScope.Commit();
        var saved = Scope.GetDraft(savedBlock.Id);
        if (saved == null) return;

        if (!State.ContentTypes.ContainsKey(saved.ContentTypeId))
        {
            var contentType = await ContentService.GetContentTypeAsync(
                new GetContentTypeParameters { Id = saved.ContentTypeId });
            if (contentType != null)
            {
                State = State.SetContentType(contentType);
            }
        }

        if (State.ContentTypes.TryGetValue(saved.ContentTypeId, out var ct))
        {
            saved.ContentTypeAlias = ct.Alias;
        }

        State = contentToEdit != null ? State.UpdateItem(saved) : State.AddItem(saved, insertAtIndex);
        // Only this block's preview changed (it, or a block inside it, was edited)
        _previews.Remove(saved.Id);
        await NotifyChanges();
    }

    private async Task NotifyChanges()
    {
        // The list's value is the block ids in order; it is part of the content this editor sits in. A reorder or a
        // removal changes no block, so the other previews are kept as they are.
        Value = JsonSerializer.Serialize(State.GetSerializedIds());
        _loadedValue = Value;
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
}
