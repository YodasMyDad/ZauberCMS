@using System.Text.Json
@using ZauberCMS.Components.ContentComponents
@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Components.Editors.Settings
@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Content.Mapping
@using ZauberCMS.Core.Content.Models
@using TupleExtensions = ZauberCMS.Core.Extensions.TupleExtensions
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty

<SortableList Id="@Alias" Items="@ContentItems" OnUpdate="@SortList" IgnoreDomChanges="@(true)" Context="item">
    <SortableItemTemplate>
        @if (ContentTypes.ContainsKey(item!.ContentTypeId))
        {
            <div>
                <div class="w-full flex justify-between items-start border @(item.Published ? "border-gray-200" : "border-orange-300 bg-orange-50") border-solid my-1 notextselection cursor-grab">
                    <div class="p-3 flex items-center justify-center relative">
                        <RadzenIcon Icon="@(ContentTypes[item!.ContentTypeId].Icon ?? "layers")" Style="font-size: 2rem" class="text-slate-600"/>
                        @if (!item.Published)
                        {
                            <RadzenIcon Icon="unpublished" Style="font-size: 1rem; position: absolute; top: 0; right: 0;" class="text-orange-600"/>
                        }
                    </div>
                    <div class="p-3 flex-1 col-span-8 border border-y-0 @(item.Published ? "border-gray-200" : "border-orange-200") border-solid">
                        <RenderBlock Content="@(item)" Stylesheets="@SettingsModel.Styleheets"
                                     TView="IContentBlockPreview"
                                     FallbackComponentType="@(typeof(ContentBlockPreviewFallback))"
                                     Parameters="@(new Dictionary<string, object> { { nameof(IContentBlockPreview.ContentType), ContentTypes[item.ContentTypeId] } })"/>
                    </div>
                    <div class="p-3 flex items-center justify-center cursor-pointer" @onclick="@(() => UpdateContent(item))">
                        <RadzenIcon Icon="edit" Style="font-size: 2rem" class="text-slate-600"/>
                    </div>
                    <div class="p-3 flex items-center justify-center cursor-pointer" @onclick="@(() => DeleteContent(item))">
                        <RadzenIcon Icon="delete" Style="font-size: 2rem" class="text-slate-600"/>
                    </div>
                </div>
            </div>   
        }
    </SortableItemTemplate>
</SortableList>

<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem" class="rz-pt-3" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
    <RadzenButton Icon="add" Size="ButtonSize.Medium" Click="@(() => UpdateContent())" class="rz-border-radius-10" />
    <div class="text-sm">Add New Block</div>
</RadzenStack>

@code {
    public string Name { get; set; } = "Block List Editor";
    public string Alias { get; set; } = "ZauberCMS.BlockListEditor";
    public string Description { get; set; } = "Creates a list of content blocks";
    public string Icon { get; set; } = "format_align_justify";
    public Type? SettingsComponent { get; set; } = typeof(BlockListEditorSettings);
    
    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public string? Settings { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Content? Content { get; set; }
    [Parameter] public Action<BlockListChanges>? ChangesPending { get; set; }
    
    [CascadingParameter] public IModalService? ModalService { get; set; }
    
    [Inject] public DialogService DialogService { get; set; } = null!;
    [Inject] public NotificationService NotificationService { get; set; } = null!;
    
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }
    
    private List<Content> ContentItems { get; set; } = [];
    private Dictionary<Guid, ContentType> ContentTypes { get; set; } = [];
    private BlockListEditorSettingsModel SettingsModel { get; set; } = new();

    // Change tracking for deferred saves
    private List<Content> AddedItems { get; set; } = [];
    private List<Content> UpdatedItems { get; set; } = [];
    private List<Content> DeletedItems { get; set; } = [];

    // Nested changes tracking - accumulates changes from nested block list editors
    private List<Content> NestedAddedItems { get; set; } = [];
    private List<Content> NestedUpdatedItems { get; set; } = [];
    private List<Content> NestedDeletedItems { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await PopulateContentTypes();
        if (!Value.IsNullOrWhiteSpace())
        {
            // Get content
            List<Guid> contentIds;
            try
            {
                contentIds = JsonSerializer.Deserialize<List<Guid>>(Value!) ?? [];
            }
            catch (JsonException)
            {
                contentIds = [];
            }
            var content = await ContentService.QueryContentAsync(new QueryContentParameters { Ids = contentIds, AmountPerPage = 100, NestedFilter = BaseQueryContentParameters.NestedContentFilter.Only, IncludeUnpublished = true });
            // Build an index map so we can preserve the original order of IDs
            var idOrder = contentIds
                .Select((id, index) => new { id, index })
                .ToDictionary(x => x.id, x => x.index);

            ContentItems = content.Items
                .OrderBy(item => idOrder.TryGetValue(item.Id, out var idx) ? idx : int.MaxValue)
                .ToList();

            // Ensure all ContentTypes are loaded for preview
            foreach (var item in ContentItems)
            {
                if (!ContentTypes.ContainsKey(item.ContentTypeId))
                {
                    var contentType = await ContentService.GetContentTypeAsync(new GetContentTypeParameters { Id = item.ContentTypeId });
                    if (contentType != null)
                    {
                        ContentTypes[item.ContentTypeId] = contentType;
                    }
                }
                // Ensure ContentTypeAlias is set for preview rendering
                if (ContentTypes.ContainsKey(item.ContentTypeId))
                {
                    item.ContentTypeAlias = ContentTypes[item.ContentTypeId].Alias;
                }
            }
        }

        SettingsModel = Settings.FromJson<BlockListEditorSettingsModel>();
    }

    private async Task PopulateContentTypes()
    {
        var contentTypes = await ContentService.QueryContentTypesAsync(new QueryContentTypesParameters { AmountPerPage = 300, OnlyElementTypes = true});
        ContentTypes = contentTypes.Items.ToDictionary(x => x.Id, x => x);
    }
    
    private async Task DeleteContent(Content content)
    {
        var delete = await DialogService.Confirm("Are you sure you want to delete this?", "Delete", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (delete == true)
        {
            var index = ContentItems.FindIndex(c => c.Id == content.Id);
            if (index != -1)
            {
                ContentItems.RemoveAt(index);
            }

            // Track the deletion for deferred processing instead of immediate delete
            DeletedItems.Add(content);

            // Update the Value to persist the deletion
            var remainingIds = ContentItems.Select(c => c.Id).ToList();
            Value = JsonSerializer.Serialize(remainingIds);
            await ValueChanged.InvokeAsync(Value);

            // Notify parent of pending changes
            NotifyParentOfChanges();
        }
    }

    private async Task UpdateContent(Content? contentUpdate = null)
    {
        var contentParams = new Dictionary<string, object>
        {
            { nameof(ContentEditor.IsBlockList), true },
            { nameof(ContentEditor.NestedParentId), Content!.Id },
            { nameof(ContentEditor.OnBlockListChanges), new Action<BlockListChanges>(HandleNestedBlockListChanges) }
        };

        // Add allowed ElementType IDs if specified in settings
        if (SettingsModel.AllowedElementTypeIds.Any())
        {
            contentParams.Add(nameof(ContentEditor.AllowedElementTypeIds), SettingsModel.AllowedElementTypeIds);
        }

        if (contentUpdate != null)
        {
            contentParams.Add(nameof(ContentEditor.ContentId), contentUpdate.Id);
        }
        else
        {
            contentParams.Add(nameof(ContentEditor.DefaultName), $"Block {(ContentItems.Count+1).ToWords()}");
        }

        if (ModalService != null)
        {
            var dialog = ModalService.OpenSidePanel<ContentEditor>("Add Content", contentParams);
            var result = await dialog.Result;
            if (result is { Confirmed: true, Data: Content content })
            {
                // This could be an issue and close dialogs on property editors!
                //DialogService.CloseSide();

                if (contentUpdate != null)
                {
                    var index = ContentItems.FindIndex(c => c.Id == contentUpdate.Id);
                    if (index != -1)
                    {
                        // Needs to be looked into, only way to get the UI to update is to create a new instance
                        var changedContent = new Content();
                        content.MapTo(changedContent);
                        changedContent.PropertyData = content.PropertyData;
                        ContentItems[index] = changedContent;

                        // Track the update for deferred processing
                        UpdatedItems.Add(changedContent);

                        // Ensure ContentType is loaded for preview
                        if (!ContentTypes.ContainsKey(content.ContentTypeId))
                        {
                            var contentType = await ContentService.GetContentTypeAsync(new GetContentTypeParameters { Id = content.ContentTypeId });
                            if (contentType != null)
                            {
                                ContentTypes[content.ContentTypeId] = contentType;
                            }
                        }
                        // Ensure ContentTypeAlias is set for preview rendering
                        if (ContentTypes.ContainsKey(content.ContentTypeId))
                        {
                            changedContent.ContentTypeAlias = ContentTypes[content.ContentTypeId].Alias;
                        }
                    }
                    else
                    {
                        // Should never get here
                        throw new Exception("Content with given id not found.");
                    }
                }
                else
                {
                    ContentItems.Add(content);

                    // Track the addition for deferred processing
                    AddedItems.Add(content);

                    // Ensure ContentType is loaded for preview
                    if (!ContentTypes.ContainsKey(content.ContentTypeId))
                    {
                        var contentType = await ContentService.GetContentTypeAsync(new GetContentTypeParameters { Id = content.ContentTypeId });
                        if (contentType != null)
                        {
                            ContentTypes[content.ContentTypeId] = contentType;
                        }
                    }
                    // Ensure ContentTypeAlias is set for preview rendering
                    if (ContentTypes.ContainsKey(content.ContentTypeId))
                    {
                        content.ContentTypeAlias = ContentTypes[content.ContentTypeId].Alias;
                    }
                }

                NotifyParentOfChanges();
            }
        }
    }

    private void HandleNestedBlockListChanges(BlockListChanges nestedChanges)
    {
        // Accumulate nested changes - these will be included in our parent changes
        NestedAddedItems.AddRange(nestedChanges.AddedItems);
        NestedUpdatedItems.AddRange(nestedChanges.UpdatedItems);
        NestedDeletedItems.AddRange(nestedChanges.DeletedItems);
    }

    private void NotifyParentOfChanges()
    {
        var changes = new BlockListChanges
        {
            // Include both direct changes and nested changes
            AddedItems = AddedItems.Concat(NestedAddedItems).ToList(),
            UpdatedItems = UpdatedItems.Concat(NestedUpdatedItems).ToList(),
            DeletedItems = DeletedItems.Concat(NestedDeletedItems).ToList()
        };

        ChangesPending?.Invoke(changes);

        // Clear nested changes after sending them to parent
        ClearNestedChanges();

        // Value is already correctly set in SortList, don't override it
    }

    private void ClearNestedChanges()
    {
        NestedAddedItems.Clear();
        NestedUpdatedItems.Clear();
        NestedDeletedItems.Clear();
    }
    
    private async Task SortList((int oldIndex, int newIndex) indices)
    {
        // This is a bit of a hack to deal with shadow doms. I need to make a copy of the content items
        // as I don't want to trigger a statehaschanged of the contents will disappear.
        var clonedList = new List<Content>();
        clonedList.AddRange(ContentItems);
        
        TupleExtensions.SortList(indices, clonedList);
        
        foreach (var content in clonedList)
        {
            // Remove content type and content values as don't want to serialise this
            content.ContentType = null;
            content.ContentTypeAlias = ContentTypes[content.ContentTypeId].Alias;
        }

        var clonedIds = clonedList.Select(x => x.Id);
        Value = JsonSerializer.Serialize(clonedIds);
        await ValueChanged.InvokeAsync(Value);

        // Notify parent that order has changed (this affects the UpdatedItems)
        NotifyParentOfChanges();
    }


}