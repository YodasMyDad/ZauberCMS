@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Extensions
@using ZauberCMS.RTE.Models
@using ZauberCMS.Components.Editors.Dialogs.Models
@using Microsoft.JSInterop
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime

<div style="min-height: 500px;">
    <RadzenSelectBar @bind-Value="@_selectedTab" Change="@((string args) => OnTabChange(args))" Style="margin-bottom: 1rem;">
        <Items>
            <RadzenSelectBarItem Text="@L["general_content"]" Value="@("content")" />
            <RadzenSelectBarItem Text="@L["editorDialogs_manualLink"]" Value="@("manual")" />
        </Items>
    </RadzenSelectBar>

    @if (_selectedTab == "content")
    {
        <div class="content-tab">
            <ContentTree ValueChanged="OnContentSelectedHandler"
                         DisableContextMenu="true"
                         DisableSectionOnlyContextMenu="true" />
            
            @if (_selectedContent != null)
            {
                <div style="margin-top: 1rem; padding: 0.5rem; background: var(--rz-info-lighter); border-radius: 4px;">
                    <strong>@L["editorDialogs_selectedContent"]</strong> @_selectedContent.Name
                </div>
            }
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right"
                     AlignItems="AlignItems.Center" class="rz-mt-3" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="@L["general_cancel"]" Click="@Cancel" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="link" Text="@L["editorDialogs_insertLink"]"
                          Click="@InsertContentLink" Disabled="@(_selectedContent == null)" />
        </RadzenStack>
    }
    else
    {
        <div class="manual-tab">
            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["general_url"]" Description="@L["editorDialogs_linkUrlDescription"]" />
                </LeftColumn>
                <CentreColumn>
                    <RadzenTextBox @bind-Value="@_url" Style="width: 100%;"
                                   Placeholder="https://example.com" aria-label="@L["general_url"]" />
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editorDialogs_linkText"]" Description="@L["editorDialogs_linkTextDescription"]" />
                </LeftColumn>
                <CentreColumn>
                    <RadzenTextBox @bind-Value="@_linkText" Style="width: 100%;"
                                   Placeholder="@L["editorDialogs_linkTextPlaceholder"]" aria-label="@L["editorDialogs_linkText"]" />
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editorDialogs_linkTitle"]" Description="@L["editorDialogs_linkTitleDescription"]" />
                </LeftColumn>
                <CentreColumn>
                    <RadzenTextBox @bind-Value="@_title" Style="width: 100%;"
                                   Placeholder="@L["editorDialogs_optional"]" aria-label="@L["editorDialogs_linkTitle"]" />
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editorDialogs_linkTarget"]" Description="@L["editorDialogs_linkTargetDescription"]" />
                </LeftColumn>
                <CentreColumn>
                    <RadzenDropDown @bind-Value="@_target" Data="@_targetOptions" Style="width: 100%;"
                                    TextProperty="Text" ValueProperty="Value" aria-label="@L["editorDialogs_linkTarget"]" />
                </CentreColumn>
            </EditorRow>

            <EditorRow>
                <LeftColumn>
                    <PropertyInfo Name="@L["editorDialogs_linkRel"]" Description="@L["editorDialogs_linkRelDescription"]" />
                </LeftColumn>
                <CentreColumn>
                    <RadzenDropDown @bind-Value="@_rel" Data="@_relOptions" Style="width: 100%;"
                                    TextProperty="Text" ValueProperty="Value" aria-label="@L["editorDialogs_linkRel"]" />
                </CentreColumn>
            </EditorRow>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right"
                     AlignItems="AlignItems.Center" class="rz-mt-3" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="@L["general_cancel"]" Click="@Cancel" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="save" Text="@L["editorDialogs_saveLink"]"
                          Click="@SaveManualLink" Disabled="@(string.IsNullOrWhiteSpace(_url))" />
        </RadzenStack>
    }
</div>

@code {
    [CascadingParameter] BlazoredModalInstance Modal { get; set; } = null!;
    
    [Parameter] public SelectionInfo? CurrentSelection { get; set; }
    [Parameter] public LinkInfo? ExistingLink { get; set; }

    /// <summary>The content an existing link points at (its <c>data-contentid</c>), so editing the link keeps it.</summary>
    [Parameter] public Guid? ExistingContentId { get; set; }

    private string _selectedTab = "content";
    private Content? _selectedContent;
    private Guid? _selectedContentId; // Track content ID for manual links
    private string? _contentIdUrl; // The URL _selectedContentId belongs to; a different URL drops the content ID
    private string _url = string.Empty;
    private string _linkText = string.Empty;
    private string _title = string.Empty;
    private string _target = string.Empty;
    private string _rel = string.Empty;

    private bool _hasContentData;
    private bool _hasManualData;

    // Filled in OnInitializedAsync: their text comes from L, which a field initialiser cannot read
    private List<OptionItem> _targetOptions = [];

    private List<OptionItem> _relOptions = [];

    protected override Task OnInitializedAsync()
    {
        _targetOptions =
        [
            new() { Text = L["editorDialogs_targetCurrentWindow"], Value = "" },
            new() { Text = L["editorDialogs_targetNewWindow"], Value = "_blank" }
        ];

        _relOptions =
        [
            new() { Text = L["general_none"], Value = "" },
            new() { Text = L["editorDialogs_relNoFollow"], Value = "nofollow" },
            new() { Text = L["editorDialogs_relNoOpener"], Value = "noopener noreferrer" }
        ];

        // If editing an existing link, populate manual tab fields
        if (ExistingLink != null)
        {
            _url = ExistingLink.Href ?? string.Empty;
            _linkText = ExistingLink.Text ?? string.Empty;
            _target = ExistingLink.Target ?? string.Empty;
            _rel = ExistingLink.Rel ?? string.Empty;
            _title = ExistingLink.Title ?? string.Empty;
            _selectedContentId = ExistingContentId;
            _contentIdUrl = _url;
            _selectedTab = "manual";
            _hasManualData = true;
        }
        else if (CurrentSelection != null && !string.IsNullOrWhiteSpace(CurrentSelection.Text))
        {
            // Pre-fill link text with selected text
            _linkText = CurrentSelection.Text;
        }
        
        return Task.CompletedTask;
    }

    private void OnContentSelectedHandler(object value)
    {
        if (value is Content content)
        {
            _selectedContent = content;
            _selectedContentId = content.Id;
            _hasContentData = true;
            
            // Auto-populate manual fields with content data
            var contentUrl = ZauberCMS.Core.Content.ContentUrl.SiteRelative(content) ?? string.Empty;
            
            _url = contentUrl;
            _contentIdUrl = contentUrl;
            _linkText = CurrentSelection?.Text ?? content.Name ?? "Link";
        }
    }

    private async Task OnTabChange(string value)
    {
        var newTab = value ?? "content";
        
        // Check if switching away from tab with data
        if (_selectedTab == "content" && _hasContentData && newTab != "content")
        {
            // Don't show confirmation - just switch to manual tab (content data is already populated)
            _hasContentData = false;
        }
        else if (_selectedTab == "manual" && _hasManualData && newTab != "manual")
        {
            var hasData = !string.IsNullOrWhiteSpace(_url) || !string.IsNullOrWhiteSpace(_linkText);
            if (hasData)
            {
                var confirmed = await JsRuntime.InvokeAsync<bool>("confirm",
                    L["editorDialogs_discardManualLinkConfirm"].Value);
                if (!confirmed)
                {
                    _selectedTab = "manual"; // Revert
                    StateHasChanged();
                    return;
                }
                // Clear manual data but keep content ID if it exists
                _url = string.Empty;
                _linkText = CurrentSelection?.Text ?? string.Empty;
                _title = string.Empty;
                _target = string.Empty;
                _rel = string.Empty;
                _hasManualData = false;
                _selectedContent = null;
                _selectedContentId = null;
            }
        }

        _selectedTab = newTab;
    }

    private async Task InsertContentLink()
    {
        if (_selectedContent == null) return;

        var linkText = CurrentSelection?.Text ?? _selectedContent.Name ?? "Link";
        // Internal links are site-relative (/blog); the rich-text validator compares in the same form (ZA-135)
        var contentUrl = ZauberCMS.Core.Content.ContentUrl.SiteRelative(_selectedContent) ?? string.Empty;

        var result = new ContentLinkResult
        {
            Content = _selectedContent,
            LinkText = linkText,
            Url = contentUrl
        };

        await Modal.CloseAsync(ModalResult.Ok(result));
    }

    private async Task SaveManualLink()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;

        // If link text is empty, use URL
        if (string.IsNullOrWhiteSpace(_linkText))
        {
            _linkText = _url;
        }

        var result = new ManualLinkResult
        {
            Url = _url,
            Text = _linkText,
            Title = _title,
            Target = _target,
            Rel = _rel,
            // Keep the content ID only while the link still points at that content's URL
            ContentId = _selectedContentId != null &&
                        ZauberCMS.Core.Content.ContentUrl.Normalize(_url) == ZauberCMS.Core.Content.ContentUrl.Normalize(_contentIdUrl)
                ? _selectedContentId
                : null
        };

        await Modal.CloseAsync(ModalResult.Ok(result));
    }

    private async Task Cancel()
    {
        await Modal.CloseAsync(ModalResult.Cancel());
    }

    private class OptionItem
    {
        public string Text { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }
}

