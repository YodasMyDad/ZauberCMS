@using ZauberCMS.Core.Settings.Interfaces
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty
@* Stores the chosen key's name, never its value (ZA-214, Roadmap D73): the value is read on the server where it is
   used (IApiKeyService.GetPickedApiKeyAsync), so whoever edits the page, its drafts and versions, or the editor's
   settings never sees it. *@

<RadzenDropDown TValue="string" Value="@_selectedName" Data="@_names" Change="@(args => OnValueChanged(args))"
                AllowClear="true" Placeholder="@L["editors_apiKeyPickerPlaceholder"]" Style="width: 100%;" aria-label="@L["editors_apiKeyPickerLabel"]"/>
@if (_unknownValue)
{
    <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">
        @L["editors_apiKeyPickerUnknownKey"]
    </RadzenText>
}

@code {
    // Discovery builds this editor to read its name, without [Inject]: the text comes through the constructor (D120)
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public ApiKeysPickerProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public ApiKeysPickerProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as every built-in editor's (D120: a subclass or a site may rename it); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_apiKeyPicker"].Value; set => _name = value; }
    public string Alias => "ZauberCMS.ApiKeyPicker";
    public string Description { get => _description ?? _text["editors_apiKeyPickerInfo"].Value; set => _description = value; }
    public string Icon => "api";
    public Type? SettingsComponent { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Settings { get; set; }
    [Parameter] public Content? Content { get; set; }
    [CascadingParameter] public IModalService? ModalService { get; set; }
    [Inject] public IApiKeyService ApiKeyService { get; set; } = null!;
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }

    private IReadOnlyList<string> _names = [];
    private string? _selectedName;
    private bool _unknownValue;

    protected override async Task OnInitializedAsync()
    {
        _names = await ApiKeyService.GetApiKeyNamesAsync();
        if (Value.IsNullOrWhiteSpace())
        {
            return;
        }

        _selectedName = _names.FirstOrDefault(name => string.Equals(name, Value, StringComparison.OrdinalIgnoreCase));
        if (_selectedName != null)
        {
            return;
        }

        // Saved before v5, the value is the key itself: show the key it belongs to, and store its name from now on
        // (the page or settings keep the old value until they are saved)
        foreach (var name in _names)
        {
            if (string.Equals(await ApiKeyService.GetApiKeyAsync(name), Value, StringComparison.Ordinal))
            {
                _selectedName = name;
                await ValueChanged.InvokeAsync(name);
                return;
            }
        }

        _unknownValue = true;
    }

    private async Task OnValueChanged(object? value)
    {
        _selectedName = value as string;
        _unknownValue = false;
        // Through ValueChanged only: the parent owns Value (Docs/Editors.md)
        await ValueChanged.InvokeAsync(_selectedName ?? string.Empty);
    }
}
