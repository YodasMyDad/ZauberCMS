@using ZauberCMS.Components.Editors.Models
@implements ZauberCMS.Core.Content.Interfaces.IContentPropertySettings<DatePickerPropertySettingsModel>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_dateMin"]" Description="@L["editors_dateMinInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenDatePicker @bind-Value="@Settings.MinDate" Name="MinDatePicker" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_dateMax"]" Description="@L["editors_dateMaxInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenDatePicker @bind-Value="@Settings.MaxDate" Name="MaxDatePicker" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_dateTimeOnly"]" Description="@L["editors_dateTimeOnlyInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Settings.ShowTimeOnly"/>
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_dateInline"]" Description="@L["editors_dateInlineInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Settings.InlineCalendar"/>
    </CentreColumn>
</EditorRow>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" class="rz-mt-3">
    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Text="@L["editors_storeSettings"]" Click="Save"/>
</RadzenStack>

@code {
    [Parameter] public string? SettingsModel { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    public DatePickerPropertySettingsModel Settings { get; set; } = new();

    protected override void OnInitialized()
    {
        Settings = this.GetPropertySettings();
    }

    private async Task Save()
    {
        await this.SavePropertySettings(Settings);
    }

}