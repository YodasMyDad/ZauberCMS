@using ZauberCMS.Components.Editors.Models
@implements ZauberCMS.Core.Content.Interfaces.IContentPropertySettings<ZauberCMS.Components.Editors.Models.ZauberCMSEditorSettingsModel>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_zauberHeight"]" Description="@L["editors_zauberHeightInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Settings.Height" Style="width: 100%;" Placeholder="@L["editors_zauberHeightExample"]" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_zauberToolbar"]" Description="@L["editors_zauberToolbarInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenDropDown @bind-Value="@Settings.ToolbarLayout" 
                        Data="@ToolbarLayouts" TextProperty="Text" ValueProperty="Value"
                        Style="width: 100%;" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_zauberBase64"]" Description="@L["editors_zauberBase64Info"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Settings.AllowBase64ImageUpload" />
    </CentreColumn>
</EditorRow>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" class="rz-mt-3">
    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Text="@L["editors_storeSettings"]" Click="Save" />
</RadzenStack>

@code {
    [Parameter] public string? SettingsModel { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    public ZauberCMSEditorSettingsModel Settings { get; set; } = new();

    // The stored values ("Full", "Minimal") with their names in the admin's language
    private List<ToolbarLayoutOption> ToolbarLayouts { get; set; } = [];

    private sealed record ToolbarLayoutOption(string Value, string Text);

    protected override void OnInitialized()
    {
        ToolbarLayouts = [new("Full", L["editors_zauberToolbarFull"]), new("Minimal", L["editors_zauberToolbarMinimal"])];
        Settings = this.GetPropertySettings();
    }

    private async Task Save()
    {
        await this.SavePropertySettings(Settings);
    }
}