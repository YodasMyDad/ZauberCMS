@using ZauberCMS.Components.Editors.Models
@implements ZauberCMS.Core.Content.Interfaces.IContentPropertySettings<NumericPropertySettingsModel>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericMin"]" Description="@L["editors_numericMinInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenNumeric @bind-Value="@Settings.Min" Style="width: 100%;" InputAttributes="@(new Dictionary<string, object> { { "aria-label", L["editors_numericMin"].Value } })"/>
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericMax"]" Description="@L["editors_numericMaxInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenNumeric @bind-Value="@Settings.Max" Style="width: 100%;" InputAttributes="@(new Dictionary<string, object> { { "aria-label", L["editors_numericMax"].Value } })"/>
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericStep"]" Description="@L["editors_numericStepInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Settings.Step" Style="width: 100%;" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericPlaceholder"]" Description="@L["editors_numericPlaceholderInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Settings.Placeholder" Style="width: 100%;" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericFormat"]" Description="@L["editors_numericFormatInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenTextBox @bind-Value="@Settings.Format" Style="width: 100%;" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_numericAlignRight"]" Description="@L["editors_numericAlignRightInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Settings.AlignRight" />
    </CentreColumn>
</EditorRow>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" class="rz-mt-3">
    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Text="@L["editors_storeSettings"]" Click="Save"/>
</RadzenStack>

@code {
    [Parameter] public string? SettingsModel { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    public NumericPropertySettingsModel Settings { get; set; } = new();

    protected override void OnInitialized()
    {
        Settings = this.GetPropertySettings();
    }

    private async Task Save()
    {
        await this.SavePropertySettings(Settings);
    }

}