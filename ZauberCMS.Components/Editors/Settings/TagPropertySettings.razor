@using ZauberCMS.Components.Editors.Models
@implements ZauberCMS.Core.Content.Interfaces.IContentPropertySettings<ZauberCMS.Components.Editors.Models.TagPropertySettingsModel>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_tagsAllowEditing"]" Description="@L["editors_tagsAllowEditingInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <RadzenSwitch @bind-Value="@Settings.AllowTagEditing" InputAttributes="@(new Dictionary<string,object>{ { "aria-label", L["editors_tagsAllowEditing"].Value }})" />
    </CentreColumn>
</EditorRow>

<EditorRow>
    <LeftColumn>
        <PropertyInfo Name="@L["editors_tagsList"]" Description="@L["editors_tagsListInfo"]"/>
    </LeftColumn>
    <CentreColumn>
        <TagEditor />
    </CentreColumn>
</EditorRow>


<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" class="rz-mt-3">
    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Text="@L["editors_storeSettings"]" Click="Save"/>
</RadzenStack>

@code {
    [Parameter] public string? SettingsModel { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    public TagPropertySettingsModel Settings { get; set; } = new();
    
    protected override void OnInitialized()
    {
        Settings = this.GetPropertySettings();
    }

    private async Task Save()
    {
        await this.SavePropertySettings(Settings);
    }

}