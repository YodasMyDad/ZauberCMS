@implements ZauberCMS.Core.Content.Interfaces.IContentProperty
@using ZauberCMS.Components.Editors.Settings
@inherits ZauberCMS.Components.Editors.Models.ListPropertyBaseComponent

<RadzenRadioButtonList Data="@SettingsModel.Items" 
                       Value="@SelectedValue" 
                       Orientation="Orientation.Vertical"
                       TValue="string" 
                       TextProperty="Name" 
                       ValueProperty="Value"
                       Change="@(args => OnChange(args))"/>

@code {
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public RadioButtonListProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public RadioButtonListProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as before v5 (a subclass or a site may rename the editor); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_radioButtonList"].Value; set => _name = value; }
    public string Alias { get; set; } = "ZauberCMS.RadioButtonList";
    public string Icon { get; set; } = "radio_button_checked";
    public string Description { get => _description ?? _text["editors_radioButtonListInfo"].Value; set => _description = value; }
    public Type? SettingsComponent { get; set; } = typeof(ListPropertySettings);
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }
}