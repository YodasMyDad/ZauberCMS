@using System.Text.Json
@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Components.Editors.Settings
@using ZauberCMS.Core.Tags.Parameters
@using ZauberCMS.Core.Tags.Models
@using ZauberCMS.Core.Tags.Services
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty

@if (SettingsModel.AllowTagEditing)
{
    <div class="mb-2">
        <RadzenButton Variant="Variant.Text" Shade="Shade.Light" Click=@(OpenTagEditor) Text="@L["editors_editTags"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
    </div>
}

<RadzenDropDown
                Data="@Tags"
                @bind-Value="@SelectedValues"
                Change="@(args => OnChange())"
                TextProperty="TagName"
                ValueProperty="Id"
                Multiple="true" 
                AllowClear="false" 
                Placeholder="@L["editors_selectTags"]" Chips="true" Style="width: 100%;"/>

@code {
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public TagsProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public TagsProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as before v5 (a subclass or a site may rename the editor); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_tags"].Value; set => _name = value; }
    public string Alias { get; set; } = "ZauberCMS.Tags";
    public string Icon { get; set; } = "sell";
    public string Description { get => _description ?? _text["editors_tagsInfo"].Value; set => _description = value; }
    public Type? SettingsComponent { get; set; } = typeof(TagPropertySettings);
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }
    
    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public string? Settings { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Content? Content { get; set; }
    [CascadingParameter] public IModalService? ModalService { get; set; }
    
    private TagPropertySettingsModel SettingsModel { get; set; } = new();
    private List<Tag> Tags { get; set; } = [];
    private IEnumerable<Guid> SelectedValues { get; set; } = [];

    private string? _readValue;
    private bool _hasRead;

    protected override void OnParametersSet()
    {
        // Only the value: the page save writes the tag links from it, when the page is published (ZA-099).
        // Read again when it changes, and an empty value clears the chips (ZA-127).
        if (_hasRead && Value == _readValue)
        {
            return;
        }

        _hasRead = true;
        _readValue = Value;
        SelectedValues = Value.IsNullOrWhiteSpace() ? [] : new TagsPropertyTagReferenceProvider().GetTagIds(Value);
    }

    protected override async Task OnInitializedAsync()
    {
        SettingsModel = Settings.FromJson<TagPropertySettingsModel>();
        await SetTags();
    }

    private async Task SetTags()
    {
        var tags = await TagService.QueryTagAsync(new QueryTagParameters { AmountPerPage = 200, OrderBy = GetTagOrderBy.SortOrder, Cached = false});
        Tags = tags.Items.ToList();
    }
    
    private async Task OnChange()
    {
        // Raised, not written to the parameter: the parent owns Value (ZA-127)
        await ValueChanged.InvokeAsync(JsonSerializer.Serialize(SelectedValues));
    }
    
    private async Task OpenTagEditor()
    {
        var modalRef = ModalService!.OpenSidePanel<TagEditor>(L["editors_editTags"]);
        var result = await modalRef.Result;
        // Refresh tags regardless of whether they saved or cancelled
        await SetTags();
        StateHasChanged();
    }

}