@using System.Text.Json
@using Microsoft.Extensions.Options
@using ZauberCMS.Components.Editors.Models
@using ZauberCMS.Components.Editors.Settings
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Settings.Interfaces
@implements ZauberCMS.Core.Content.Interfaces.IContentProperty

@if (Location is { Lat: not 0, Lng: not 0 })
{
    <div>
        <RadzenText TextStyle="TextStyle.Subtitle1">@L["editors_mapLocation", Location.Lat, Location.Lng]</RadzenText>
    </div>
}
@* Not before the key is known: the map loads Google's script with the key on its first render *@
@if (_keyLoaded && ApiKey.IsNullOrWhiteSpace())
{
    <div>@L["editors_googleMapsNoApiKey"]</div>
}

@if (_keyLoaded)
{
    <RadzenGoogleMap ApiKey="@ApiKey" MapId="@(MapId.ToString())" @ref="Map" 
                     Style="height: 400px" 
                     Options=@(new Dictionary<string, object> { { "disableDoubleClickZoom", true } })
                     Zoom="@SettingsModel.ZoomLevel" 
                     Center="@(Location)" 
                     MapClick="@OnMapClick">
        <Markers>
                <RadzenGoogleMapMarker Title="" Position="@(Location)" />   
        </Markers>
    </RadzenGoogleMap>
}

@code {
    private readonly IStringLocalizer<ZauberText> _text;

    /// <summary>For code that only reads the editor's alias or type (a starter kit): its text is ZauberCMS's English.</summary>
    public GoogleMapsProperty() : this(Models.EditorText.English)
    {
    }

    [Microsoft.Extensions.DependencyInjection.ActivatorUtilitiesConstructor]
    public GoogleMapsProperty(IStringLocalizer<ZauberText> text) => _text = text;

    // Settable, as before v5 (a subclass or a site may rename the editor); unset, ZauberCMS's text
    private string? _name;
    private string? _description;

    public string Name { get => _name ?? _text["editors_googleMapPicker"].Value; set => _name = value; }
    public string Alias { get; set; } = "ZauberCMS.GoogleMapPicker";
    public string Icon { get; set; } = "add_location";
    public string Description { get => _description ?? _text["editors_googleMapPickerInfo"].Value; set => _description = value; }
    public Type? SettingsComponent { get; set; } = typeof(GoogleMapsPropertySettings);
    public List<string> Scripts { get; set; } = [];
    public List<string> Styles { get; set; } = [];
    public bool FullWidth { get; set; }
    
    [Inject] public IModalService DialogService { get; set; } = null!;
    [Inject] public IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] IOptions<ZauberSettings> ZauberSettings { get; set; } = null!;

    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Settings { get; set; } = string.Empty;
    [Parameter] public Content? Content { get; set; }

    [CascadingParameter] public IModalService? ModalService { get; set; }

    private GoogleMapsSettingsModel SettingsModel { get; set; } = new();
    private GoogleMapPosition Location { get; set; } = new();
    private RadzenGoogleMap? Map { get; set; }
    private Guid MapId { get; set; }
    private string? ApiKey { get; set; }
    [Inject] public IApiKeyService ApiKeyService { get; set; } = null!;
    private bool _keyLoaded;
    
    // Once per editor: a new map id on every parameter set rebuilt the map and lost its position (ZA-127)
    protected override async Task OnInitializedAsync()
    {
        MapId = Guid.NewGuid();
        SettingsModel = Settings.FromJson<GoogleMapsSettingsModel>();
        if (!Value.IsNullOrWhiteSpace())
        {
            Location = JsonSerializer.Deserialize<GoogleMapPosition>(Value) ?? new GoogleMapPosition { Lat = 51.5074, Lng = 0.1278};
        }
        else if (SettingsModel is { DefaultLng: not null, DefaultLat: not null })
        {
            Location.Lng = SettingsModel.DefaultLng.Value;
            Location.Lat = SettingsModel.DefaultLat.Value;
        }

        // Configuration's key or Global Settings' (D73). The Maps JavaScript key is a browser key: it reaches the
        // browser by design, so restrict it to the site's addresses in Google's console.
        ApiKey = await ApiKeyService.GetApiKeyAsync("GoogleMaps");
        _keyLoaded = true;
    }

    private async Task OnMapClick(GoogleMapClickEventArgs args)
    {
        if (args.Position is null)
        {
            return;
        }

        Location.Lat = args.Position.Lat;
        Location.Lng = args.Position.Lng;
        await ValueChanged.InvokeAsync(JsonSerializer.Serialize(Location));
    }

}