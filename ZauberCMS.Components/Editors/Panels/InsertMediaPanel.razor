@using ZauberCMS.Core.Media.Models
@using ZauberCMS.RTE.Models
@inherits PanelBase
@inject NotificationService NotificationService

<div class="rte-panel-content">
    <h3 class="rte-panel-title">Insert Media</h3>
    
    <div class="rte-form-group">
        <MediaTree ValueChanged="@OnMediaSelected" 
                   DisableContextMenu="true" 
                   DisableSectionOnlyContextMenu="true" />
    </div>

    <div class="rte-panel-actions">
        <button type="button" class="rte-btn rte-btn-secondary" @onclick="CloseAsync">
            Cancel
        </button>
        <button type="button" class="rte-btn rte-btn-primary" @onclick="InsertMediaAsync" disabled="@(SelectedMedia == null)">
            Insert
        </button>
    </div>
</div>

@code {
    private Media? SelectedMedia { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        
        if (firstRender && Api != null)
        {
            await Api.SaveSelectionRangeAsync();
        }
    }

    private void OnMediaSelected(object value)
    {
        if (value is Media media && media.MediaType != MediaType.Folder)
        {
            SelectedMedia = media;
            StateHasChanged();
        }
    }

    private async Task InsertMediaAsync()
    {
        if (SelectedMedia == null || Api == null) return;

        try
        {
            await Api.RestoreSelectionRangeAsync();

            var html = SelectedMedia.MediaType == MediaType.Image 
                ? BuildImageHtml(SelectedMedia) 
                : BuildLinkHtml(SelectedMedia);

            await Api.InsertHtmlAsync(html);
            await Api.ClearSavedSelectionRangeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Insert Failed",
                Detail = $"Failed to insert media: {ex.Message}",
                Duration = 4000
            });
        }
    }

    private static string BuildImageHtml(Media media)
    {
        var attributes = new List<string>
        {
            $"src=\"{media.Url ?? ""}\"",
            $"data-mediaid=\"{media.Id}\""
        };
        
        if (media.Width > 0)
        {
            attributes.Add($"width=\"{media.Width}\"");
        }
        
        if (media.Height > 0)
        {
            attributes.Add($"height=\"{media.Height}\"");
        }
        
        var altText = media.AltTag ?? media.Name ?? "";
        attributes.Add($"alt=\"{System.Web.HttpUtility.HtmlEncode(altText)}\"");
        
        return $"<img {string.Join(" ", attributes)} />";
    }

    private static string BuildLinkHtml(Media media)
    {
        var linkText = System.Web.HttpUtility.HtmlEncode(media.Name ?? "Download");
        return $"<a href=\"{media.Url ?? ""}\" data-mediaid=\"{media.Id}\">{linkText}</a>";
    }
}

