@using ZauberCMS.Core
@using ZauberCMS.Core.Shared
@using ZauberCMS.Core.Shared.Models
@using ZauberCMS.Core.Media.Parameters
@using ZauberCMS.Core.Media.Models
@implements IDisposable

<BaseTree T="object"
          Data="@_roots"
          TreeAlias="@Constants.Sections.Trees.MediaTree"
          Expand="@OnExpandHandler"
          Change="@OnChangeHandler"
          @bind-Value="@Value"
          HasChildren="@(e => HasChildren(e))"
          ShouldBeExpanded="@(e => ShouldBeExpanded(e))"
          DisableContextMenu="DisableContextMenu"
          DisableSectionOnlyContextMenu="DisableSectionOnlyContextMenu"
          Template="@(TreeExtensions.CreateMediaTreeTemplate<object>(this, LoadMoreAsync))">
</BaseTree>

@code {
    [Inject] public AppState AppState { get; set; } = null!;
    [Inject] public TreeState TreeState { get; set; } = null!;

    /// <summary>The top level to show. Empty (the default): the top-level media, loaded and refreshed by the tree.</summary>
    [Parameter] public IEnumerable<Media> Data { get; set; } = [];
    [Parameter] public List<MediaType> MediaTypes { get; set; } = [];
    [Parameter] public EventCallback<TreeExpandEventArgs> OnExpand { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<TreeItemContextMenuEventArgs> OnItemContextMenu { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public EventCallback<object> ValueChanged { get; set; }
    [Parameter] public bool DisableContextMenu { get; set; }
    [Parameter] public bool DisableSectionOnlyContextMenu { get; set; }

    [CascadingParameter] public IModalService? ModalService { get; set; }

    // Each level is loaded a page at a time with its folders' "has children" flags (Roadmap D26); rendering no
    // longer blocks on a query per folder (ZA-054, ZA-068)
    private List<object> _roots = [];
    private readonly Dictionary<Guid, List<object>> _children = new();
    private IEnumerable<Media>? _givenData;
    private bool _loaded;
    private object? _lastValue;

    // This tree's own "has children" flags: TreeState's are shared by every tree in the circuit (a bin tree clears
    // them, a filtered picker writes different values for the same folder) and nothing would load them again
    private readonly HashSet<Guid> _withChildren = [];

    private bool OwnsData => !Data.Any();

    protected override void OnInitialized()
    {
        AppState.OnMediaChanged += HandleMediaChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Value is not TreeLoadMore)
        {
            // What "Show more" puts back: the caller may have changed or cleared the selection
            _lastValue = Value;
        }

        if (OwnsData)
        {
            if (!_loaded || _givenData != null)
            {
                _givenData = null;
                _loaded = true;
                await LoadRootsAsync();
            }
        }
        else if (!ReferenceEquals(Data, _givenData))
        {
            // A top level from the caller: only its flags are loaded
            _givenData = Data;
            var given = Data.ToList();
            var level = await MediaService.GetMediaTreeLevelAsync(new MediaTreeLevelParameters
            {
                Ids = given.Select(m => m.Id).ToList(), Take = given.Count, MediaTypes = MediaTypes
            });
            _withChildren.UnionWith(level.IdsWithChildren);
            _roots = given.Cast<object>().ToList();
        }
    }

    private Task HandleMediaChanged(Media? media, string username) => InvokeAsync(RefreshData);

    /// <summary>Reloads the tree's own top level (a tree given its top level by its caller is refreshed by it).</summary>
    public async Task RefreshData()
    {
        _withChildren.Clear();
        _children.Clear();
        if (OwnsData)
        {
            await LoadRootsAsync();
        }
        else
        {
            // A top level from the caller: load its flags again
            _givenData = null;
            await OnParametersSetAsync();
        }

        StateHasChanged();
    }

    private async Task LoadRootsAsync()
    {
        _children.Clear();
        _roots = await LoadLevelAsync(null, 0);
    }

    /// <summary>A page of <paramref name="parentId"/>'s children (null: the top level), with a "Show more" row
    /// after it when there are more.</summary>
    private async Task<List<object>> LoadLevelAsync(Guid? parentId, int skip)
    {
        var level = await MediaService.GetMediaTreeLevelAsync(new MediaTreeLevelParameters
        {
            ParentId = parentId, Skip = skip, MediaTypes = MediaTypes
        });
        foreach (var item in level.Items)
        {
            _withChildren.Remove(item.Id);
        }

        _withChildren.UnionWith(level.IdsWithChildren);
        var items = level.Items.Cast<object>().ToList();
        if (TreeLoadMore.After(level, parentId) is { } more)
        {
            items.Add(more);
        }

        return items;
    }

    private async Task OnExpandHandler(TreeExpandEventArgs args)
    {
        if (OnExpand.HasDelegate)
        {
            await OnExpand.InvokeAsync(args);
            return;
        }

        if (args.Value is Media media)
        {
            var children = await LoadLevelAsync(media.Id, 0);
            _children[media.Id] = children;
            args.Children!.Data = children;
            args.Children.Text = TreeExtensions.TreeNodeText;
            args.Children.Template = TreeExtensions.CreateMediaTreeTemplate<RadzenTreeItem>(this, LoadMoreAsync);
            args.Children.HasChildren = HasChildren;
            // Nodes that were open stay open when the tree reloads
            args.Children.Expanded = ShouldBeExpanded;

            TreeState.NodeExpanded(media.Id);
        }
    }

    private async Task OnChangeHandler()
    {
        if (Value is TreeLoadMore more)
        {
            // Not a selection: load the next page in the row's place and keep what was selected
            Value = _lastValue;
            await LoadMoreAsync(more);
            return;
        }

        _lastValue = Value;
        await ValueChanged.InvokeAsync(Value);
        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync();
        }
    }

    private async Task LoadMoreAsync(TreeLoadMore more)
    {
        var list = more.ParentId == null ? _roots : _children.GetValueOrDefault(more.ParentId.Value);
        if (list == null)
        {
            return;
        }

        var next = await LoadLevelAsync(more.ParentId, more.Skip);
        if (!list.Remove(more))
        {
            // Already loaded (clicked again while loading), or the level was reloaded meanwhile
            return;
        }

        list.AddRange(next);
        if (more.ParentId == null)
        {
            // A new list, so the tree sees the change in its top level
            _roots = [.. _roots];
        }

        StateHasChanged();
    }

    // From the flags loaded with the folder's level: no query while rendering (ZA-054)
    private bool HasChildren(object data) =>
        data is Media { MediaType: MediaType.Folder } media && _withChildren.Contains(media.Id);

    private bool ShouldBeExpanded(object data) =>
        data is Media { MediaType: MediaType.Folder } media && TreeState.IsNodeExpanded(media.Id);

    public void Dispose()
    {
        AppState.OnMediaChanged -= HandleMediaChanged;
    }
}
