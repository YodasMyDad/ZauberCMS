@using ZauberCMS.Core.Plugins
@typeparam TView where TView : IContentBlock

@if (Content != null)
{
    if (Content.ContentTypeAlias != null && ViewsByAlias.TryGetValue(Content.ContentTypeAlias, out var blockViewType))
    {
        <div>
            <DynamicComponent Parameters="@(_viewParameters)" Type="@blockViewType" />
        </div>
    }
    else if (FallbackComponentType != null)
    {
        <DynamicComponent Parameters="@(_viewParameters)" Type="@FallbackComponentType" />
    }
}

@code
{
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Parameter] public Content? Content { get; set; }
    [Parameter] public Type? FallbackComponentType { get; set; }
    [Parameter] public Dictionary<string, object> Parameters { get; set; } = new();

    /// <summary>No longer used: admin block previews are rendered by the Block List editor's <c>BlockPreview</c>,
    /// which puts them in a shadow root with these stylesheets.</summary>
    [Obsolete("Ignored. Admin block previews are rendered by BlockPreview with the Block List editor's stylesheets.")]
    [Parameter] public List<string> Stylesheets { get; set; } = [];

    // The block view type for each content type alias, built once per TView: making an instance of every block
    // view to read its alias, on every render of every block, was the cost (ZA-063). The first view found for an
    // alias wins, as before.
    private static IReadOnlyDictionary<string, Type>? _viewsByAlias;

    private IReadOnlyDictionary<string, Type> ViewsByAlias => _viewsByAlias ??= ExtensionManager
        .GetInstances<TView>(true).Values
        .Where(view => view.ContentTypeAlias != null)
        .GroupBy(view => view.ContentTypeAlias!, StringComparer.Ordinal)
        .ToDictionary(group => group.Key, group => group.First().GetType(), StringComparer.Ordinal);

    // The parameters handed to the block view: the caller's plus Content. Built into a field, not written back to the
    // Parameters parameter (the caller owns it), and only when Content or the caller's dictionary changes (ZA-127).
    // Nested block lists rely on a new Content reaching the view.
    private Dictionary<string, object> _viewParameters = new();
    private Content? _builtFor;
    private Dictionary<string, object>? _builtFrom;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Content, _builtFor) && ReferenceEquals(Parameters, _builtFrom))
        {
            return;
        }

        _builtFor = Content;
        _builtFrom = Parameters;
        _viewParameters = new Dictionary<string, object>(Parameters)
        {
            ["Content"] = Content!
        };
    }
}
