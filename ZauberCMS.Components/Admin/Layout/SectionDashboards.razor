@using ZauberCMS.Core.Plugins
@using ZauberCMS.Core.Sections.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@if (Dashboards.Any())
{
    <RadzenPanel Class="rz-mx-auto">
        <RadzenTabs @bind-SelectedIndex=@SelectedIndex>
            <Tabs>
                @foreach (var sectionDashboard in Dashboards.OrderBy(x => x.Value.SortOrder))
                {
                    <RadzenTabsItem Text="@(sectionDashboard.Value.TabName)">
                        @* A dashboard that throws shows its error in its tab (ZA-097, D32) *@
                        <AdminErrorBoundary Name="@(L["layout_dashboardBoundary", sectionDashboard.Value.TabName])">
                            <DynamicComponent Type="@sectionDashboard.Value.GetType()"/>
                        </AdminErrorBoundary>
                    </RadzenTabsItem>
                }
            </Tabs>
        </RadzenTabs>
    </RadzenPanel>
}

@code {
    [Parameter] public string? SectionAlias { get; set; }
    [Inject] public ExtensionManager ExtensionManager { get; set; } = null!;
    [Inject] public IAuthorizationService AuthorizationService { get; set; } = null!;
    [Inject] public IAuthorizationPolicyProvider AuthorizationPolicyProvider { get; set; } = null!;
    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    private Dictionary<string, ISectionDashboard> Dashboards { get; set; } = new();
    private int SelectedIndex { get; set; }
    protected override async Task OnInitializedAsync()
    {
        // A dashboard with [Authorize] shows only to users who pass it (Roadmap D67)
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var dashboards = new Dictionary<string, ISectionDashboard>();
        foreach (var (key, dashboard) in ExtensionManager.GetInstances<ISectionDashboard>(true))
        {
            if (dashboard.SectionAlias.Equals(SectionAlias, StringComparison.OrdinalIgnoreCase) &&
                await AdminExtensionAccess.MayUseAsync(dashboard.GetType(), user, AuthorizationService, AuthorizationPolicyProvider))
            {
                dashboards[key] = dashboard;
            }
        }

        Dashboards = dashboards;
    }

}