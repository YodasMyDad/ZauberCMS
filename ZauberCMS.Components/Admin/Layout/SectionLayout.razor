@using System.Globalization
@using Microsoft.AspNetCore.Http
@using ZauberCMS.Core
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Shared
@using Microsoft.Extensions.Options
@inherits LayoutComponentBase



<HeadContent>
    <SectionOutlet SectionId="@Sections.PageHeadContent"/>
</HeadContent>

@* The one host for Radzen dialogs, notifications, context menus and tooltips. A second one doubles them (ZA-138). *@
<RadzenComponents />
<CascadingBlazoredModal>
    <RadzenLayout>
        @* IsFixed: consumers only call SetSection. Without it every layout re-render (sidebar toggle,
           SetSection) sets the parameters of every consumer again, which made editors reload (ZA-058). *@
        <CascadingValue Value="@this" IsFixed="true">
            <RadzenHeader class="rz-background-color-primary-darker flex justify-between items-center">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5"
                             Style="height: 100%;">
                    <RadzenSidebarToggle Click="@(() => ToggleSideBar())"/>
                    @*<RadzenIcon Icon="automation"/>*@
                    <ZauberCMS.Components.Shared.ZauberLogo Styles="height: 24px; colour: #fff; fill: #fff;" />
                    <SectionLinks CurrentSection="@(SectionAlias)"/>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5"
                             Style="height: 100%;">
                    <RadzenAppearanceToggle />
                    <UserProfile/>
                </RadzenStack>
            </RadzenHeader>
            @if (!SectionAlias.IsNullOrWhiteSpace())
            {
                <RadzenSidebar @bind-Expanded="@Expanded">
                    <SectionTrees SectionAlias="@(SectionAlias)"/>
                </RadzenSidebar>
            }
            <RadzenBody>
                @Body
            </RadzenBody>
        </CascadingValue>
    </RadzenLayout>
</CascadingBlazoredModal>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] public IOptions<ZauberSettings> ZauberSettings { get; set; } = null!;
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;
    [Inject] public TreeState TreeState { get; set; } = null!;
    
    // The admin IP allow-list is enforced for every /admin request by AdminAccessMiddleware, not here.

    protected override void OnInitialized()
    {
        // CultureMiddleware (requests) and AdminCultureCircuitHandler (circuits) keep the admin in its language;
        // this covers the first render. It must not set the process-wide default culture.
        ZauberCMS.Core.Languages.AdminCulture.Apply(Settings.Value);
    }
    
    private string? SectionAlias { get; set; }

    public void SetSection(string value)
    {
        SectionAlias = value;
        TreeState.CurrentSection = value;
        StateHasChanged();
    }

    private bool Expanded { get; set; } = true;

    private void ToggleSideBar()
    {
        Expanded = !Expanded;
    }

    internal static class Sections
    {
        internal static readonly SectionOutlet? PageHeadContent = new();
    }

}