@using System.Globalization
@using Microsoft.AspNetCore.Http
@using ZauberCMS.Core
@using ZauberCMS.Core.Settings
@using ZauberCMS.Core.Shared
@using Microsoft.Extensions.Options
@inherits LayoutComponentBase



<HeadContent>
    <SectionOutlet SectionId="@Sections.PageHeadContent"/>
</HeadContent>

@* The one host for Radzen dialogs, notifications, context menus and tooltips. A second one doubles them (ZA-138).
   A dialog or side panel opened with DialogService that throws shows its error here instead of ending the circuit
   (ZA-097, D32); its dialogs close, the page stays. *@
<AdminErrorBoundary @ref="_dialogsBoundary" Name="@L["layout_dialogBoundary"]">
    <ChildContent>
        <RadzenComponents />
    </ChildContent>
    <ErrorContent>
        <div class="zauber-dialog-error" role="alert">
            <TailwindAlert Type="ZauberCMS.Core.Shared.Models.AlertType.Error" Title="@L["layout_dialogFailed"]"
                           DefaultMessage="@_dialogsBoundary?.Describe(context)"/>
            <RadzenButton Variant="Variant.Outlined" Size="ButtonSize.Small" Icon="close" Text="@L["general_close"]" class="mt-2"
                          Click="@(() => _dialogsBoundary?.Recover())"/>
        </div>
    </ErrorContent>
</AdminErrorBoundary>
<CascadingBlazoredModal>
    <RadzenLayout>
        @* IsFixed: consumers only call SetSection. Without it every layout re-render (sidebar toggle,
           SetSection) sets the parameters of every consumer again, which made editors reload (ZA-058). *@
        <CascadingValue Value="@this" IsFixed="true">
            <RadzenHeader class="rz-background-color-primary-darker flex justify-between items-center">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5"
                             Style="height: 100%;">
                    <RadzenSidebarToggle Click="@(() => ToggleSideBar())"/>
                    @*<RadzenIcon Icon="automation"/>*@
                    <ZauberCMS.Components.Shared.ZauberLogo Styles="height: 24px; colour: #fff; fill: #fff;" />
                    <SectionLinks CurrentSection="@(SectionAlias)"/>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5"
                             Style="height: 100%;">
                    <RadzenAppearanceToggle />
                    <UserProfile/>
                </RadzenStack>
            </RadzenHeader>
            @if (!SectionAlias.IsNullOrWhiteSpace())
            {
                @* The navigation's width can be dragged (wwwroot/js/admin-sidebar.js, loaded by App.razor): the trees
                   scroll inside the sidebar, so the divider on its edge stays in place. *@
                <RadzenSidebar @bind-Expanded="@Expanded" Style="position: relative; overflow: hidden; display: flex;">
                    <div class="zauber-sidebar-scroll">
                        @* The trees, nav groups and nav items, plugins' included: one that throws leaves the page open *@
                        <AdminErrorBoundary @ref="_treesBoundary" Name="@L["layout_navigationBoundary"]">
                            <SectionTrees SectionAlias="@(SectionAlias)"/>
                        </AdminErrorBoundary>
                    </div>
                    <div class="zauber-sidebar-resizer" role="separator" aria-orientation="vertical" tabindex="0"
                         aria-label="@L["layout_navigationWidth"]"
                         title="@L["layout_navigationWidthHint"]"></div>
                </RadzenSidebar>
            }
            <RadzenBody>
                @* The last line of defence for the page (ZA-097, D32): an error the page's own boundaries don't
                   catch shows here, and the header and navigation stay, so the user can move on. Going to
                   another page clears it. *@
                <AdminErrorBoundary @ref="_bodyBoundary" Name="@L["layout_thisPage"]">
                    @Body
                </AdminErrorBoundary>
            </RadzenBody>
        </CascadingValue>
    </RadzenLayout>
</CascadingBlazoredModal>


<div id="blazor-error-ui" data-nosnippet>
    @L["layout_unhandledError"]
    <a href="." class="reload">@L["layout_reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] public IOptions<ZauberSettings> ZauberSettings { get; set; } = null!;
    [Inject] public IOptions<ZauberSettings> Settings { get; set; } = null!;
    [Inject] public TreeState TreeState { get; set; } = null!;
    
    // The admin IP allow-list is enforced for every /admin request by AdminAccessMiddleware, not here.
    // The admin's language comes from CultureMiddleware (requests) and AdminCultureCircuitHandler (every circuit
    // activity, the first render included); a culture set in a lifecycle method here never reached the render
    // (ZA-308), so the layout sets none.

    private AdminErrorBoundary? _bodyBoundary;
    private AdminErrorBoundary? _treesBoundary;
    private AdminErrorBoundary? _dialogsBoundary;

    protected override void OnParametersSet()
    {
        // The router sets the layout's parameters on every navigation: the new page starts without the old error
        _bodyBoundary?.Recover();
        _treesBoundary?.Recover();
        _dialogsBoundary?.Recover();
    }

    private string? SectionAlias { get; set; }

    public void SetSection(string value)
    {
        SectionAlias = value;
        TreeState.CurrentSection = value;
        StateHasChanged();
    }

    private bool Expanded { get; set; } = true;

    private void ToggleSideBar()
    {
        Expanded = !Expanded;
    }

    internal static class Sections
    {
        internal static readonly SectionOutlet? PageHeadContent = new();
    }

}