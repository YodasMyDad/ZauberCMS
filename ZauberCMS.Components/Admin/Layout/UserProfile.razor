@using Microsoft.AspNetCore.Components.Authorization

<RadzenProfileMenu class="rz-background-color-primary-darker">
    <Template>
        <RadzenGravatar Email="@AuthState?.User.GetUserEmail()"/>
    </Template>
    <ChildContent>
        @* Every back-office user changes their own name, email address and password here (Roadmap D72); the
           panel offers their page in Users to those who may open Users. Nothing here reads the database, so the
           header cannot fail on it (ZA-215). *@
        <ProfileMenuItem Icon="person" Name="@L["layout_yourAccount"]" OnClick="() => OpenAccount()"/>
        <ProfileMenuItem Icon="logout" Name="@L["layout_logout"]" OnClick="() => Logout()"/>
    </ChildContent>
</RadzenProfileMenu>

@code {

    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    [CascadingParameter] public IModalService? ModalService { get; set; }
    private AuthenticationState? AuthState { get; set; }

    private void OpenAccount()
    {
        ModalService?.OpenSidePanel<CurrentUserPanel>(L["layout_yourAccount"]);
    }

    private void Logout()
    {
        NavigationManager.NavigateTo(Urls.ApiLogout, true);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    }

}
