@using Microsoft.AspNetCore.Components.Authorization

<RadzenProfileMenu class="rz-background-color-primary-darker">
    <Template>
        <RadzenGravatar Email="@AuthState.User.GetUserEmail()"/>
    </Template>
    <ChildContent>
        @* The account is edited on its page in the Users section, so only for those who may open it (Roadmap D70) *@
        @if (_mayOpenUsers)
        {
            <ProfileMenuItem Icon="edit" Name="Edit" OnClick="() => Edit()"/>
        }
        <ProfileMenuItem Icon="logout" Name="Logout" OnClick="() => Logout()"/>
    </ChildContent>
</RadzenProfileMenu>

@code {

    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    [Inject] public ZauberCMS.Core.Sections.Interfaces.IBackOfficeAccessService BackOfficeAccess { get; set; } = null!;
    private AuthenticationState AuthState { get; set; } = null!;
    private bool _mayOpenUsers;

    private void Edit()
    {
        NavigationManager.NavigateTo($"{Urls.AdminUsersEdit}/{AuthState.User.GetUserId()}");
    }

    private void Logout()
    {
        NavigationManager.NavigateTo(Urls.ApiLogout, true);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _mayOpenUsers = await BackOfficeAccess.CanOpenSectionAsync(AuthState.User, Constants.Sections.UsersSection);
    }

}

