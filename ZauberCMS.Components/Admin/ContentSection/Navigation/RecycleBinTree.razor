@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Shared
@using ZauberCMS.Core.Shared.Models
@implements ZauberCMS.Core.Sections.Interfaces.ISectionNav
@implements IDisposable

@* The content recycle bin. Its nodes are TreeBranch items (the RecycleBinTree context menus read them): the top of
   the bin a page at a time, most recently binned first, and below a binned page what went to the bin with it
   (ZA-156). A "Show more" row ends a level that has more. *@
<div>
    <BaseTree
        TreeAlias="@Constants.Sections.Trees.RecycleBinTree"
        T="TreeStub"
        Data="@TreeItems"
        Expand="@OnExpandHandler"
        Change="@OnChangeHandler"
        @bind-Value="@Selection"
        HasChildren="@(e => HasChildren(e))"
        ShouldBeExpanded="@(e => ShouldBeExpanded(e))"
        DisableSectionOnlyContextMenu="@(true)"
        Template="@(TreeExtensions.CreateStandardTreeTemplate<object>(this, LoadMoreAsync))">
    </BaseTree>
</div>

@code {
    [Inject] public AppState AppState { get; set; } = null!;
    [Inject] public TreeState TreeState { get; set; } = null!;

    public int SortOrder => 100;
    public string SectionNavGroupAlias => Constants.Sections.SectionNavGroups.ContentNavGroup;

    private object? Selection { get; set; }
    // What a keyboard "Show more" puts back (the row is selected, not the item)
    private object? _lastSelection;
    private IEnumerable<TreeStub> TreeItems { get; set; } = [];

    // The top of the bin and each opened item's level: TreeBranch nodes, then a TreeLoadMore row while there are more
    private List<object> _top = [];
    private readonly Dictionary<Guid, List<object>> _children = new();
    private readonly HashSet<Guid> _withChildren = [];

    // Bumped by every refresh: a page that finishes loading after a newer refresh is dropped
    private int _version;

    protected override async Task OnInitializedAsync()
    {
        await DataRefresh();
        TreeState.OnTreeValueChanged += TreeStateOnOnTreeValueChanged;
        AppState.OnContentChanged += HandleContentChanged;
    }

    /// <summary>
    /// Remove the selected state
    /// </summary>
    /// <param name="obj"></param>
    private void TreeStateOnOnTreeValueChanged(object? obj)
    {
        if (obj != Selection)
        {
            Selection = null;
            _lastSelection = null;
            StateHasChanged();
        }
    }

    private async Task DataRefresh()
    {
        var version = ++_version;
        var top = await LoadLevelAsync(null, 0, version);
        if (top == null)
        {
            return;
        }

        _children.Clear();
        _top = top;
        // A new root each time, so the tree builds its levels again (expanded items load their level again)
        TreeItems =
        [
            new TreeStub
            {
                Id = Constants.Guids.RecycleBinRootId,
                Name = L["content_recycleBin"].Value,
                Icon = "delete",
                SortOrder = 1,
                StubType = typeof(TreeStub)
            }
        ];
    }

    /// <summary>A page of the bin's top (<paramref name="parentId"/> null) or of what is below a binned item, with a
    /// "Show more" row after it when there are more; null when a newer refresh started meanwhile.</summary>
    private async Task<List<object>?> LoadLevelAsync(Guid? parentId, int skip, int version)
    {
        var level = await ContentService.GetContentTreeLevelAsync(new ContentTreeLevelParameters
        {
            InRecycleBin = true,
            ParentId = parentId,
            Skip = skip
        });
        if (version != _version)
        {
            return null;
        }

        foreach (var item in level.Items)
        {
            _withChildren.Remove(item.Id);
        }

        _withChildren.UnionWith(level.IdsWithChildren);
        var items = level.Items.Select(content => (object)new TreeBranch
        {
            Icon = content.ContentType?.Icon,
            Id = content.Id,
            Name = content.Name,
            Url = $"{Urls.AdminUpdateContent}/{content.Id}",
            BranchType = typeof(Content)
        }).ToList();
        if (TreeLoadMore.After(level, parentId) is { } more)
        {
            items.Add(more);
        }

        return items;
    }

    private Task HandleContentChanged(Content? content, string username)
        => InvokeAsync(async () =>
        {
            await DataRefresh();
            StateHasChanged();
        });

    private async Task OnExpandHandler(TreeExpandEventArgs args)
    {
        List<object>? children;
        Guid id;
        switch (args.Value)
        {
            case TreeStub stub:
                id = stub.Id;
                children = _top;
                break;
            case TreeBranch branch:
                id = branch.Id;
                children = await LoadLevelAsync(branch.Id, 0, _version);
                if (children == null)
                {
                    return;
                }

                _children[branch.Id] = children;
                break;
            default:
                return;
        }

        args.Children!.Data = children;
        args.Children.Text = TreeExtensions.TreeNodeText;
        args.Children.Template = TreeExtensions.CreateStandardTreeTemplate<RadzenTreeItem>(this, LoadMoreAsync);
        args.Children.HasChildren = HasChildren;
        // Items that were open stay open when the bin reloads
        args.Children.Expanded = ShouldBeExpanded;
        TreeState.NodeExpanded(id);
    }

    private async Task OnChangeHandler()
    {
        if (Selection is TreeLoadMore more)
        {
            // Chosen with the keyboard (a click on the row's button never selects it): the next page, not a selection
            Selection = _lastSelection;
            await LoadMoreAsync(more);
            return;
        }

        _lastSelection = Selection;
        TreeState.TreeValue = Selection;
        if (Selection is TreeBranch branch && !branch.Url.IsNullOrWhiteSpace())
        {
            NavigationManager.NavigateTo(NavigationManager.ToSiteUrl(branch.Url));
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync(TreeLoadMore more)
    {
        var list = more.ParentId == null ? _top : _children.GetValueOrDefault(more.ParentId.Value);
        if (list == null)
        {
            return;
        }

        var next = await LoadLevelAsync(more.ParentId, more.Skip, _version);
        if (next == null || !list.Remove(more))
        {
            // The bin was reloaded meanwhile, or this page is already loaded (chosen twice)
            return;
        }

        list.AddRange(next);
        StateHasChanged();
    }

    private bool HasChildren(object data) => data switch
    {
        TreeStub => _top.Count > 0,
        TreeBranch branch => _withChildren.Contains(branch.Id),
        _ => false
    };

    private bool ShouldBeExpanded(object data) => data switch
    {
        TreeStub stub => TreeState.IsNodeExpanded(stub.Id) || _top.Count > 0,
        TreeBranch branch => TreeState.IsNodeExpanded(branch.Id) && _withChildren.Contains(branch.Id),
        _ => false
    };

    public void Dispose()
    {
        AppState.OnContentChanged -= HandleContentChanged;
        TreeState.OnTreeValueChanged -= TreeStateOnOnTreeValueChanged;
    }
}
