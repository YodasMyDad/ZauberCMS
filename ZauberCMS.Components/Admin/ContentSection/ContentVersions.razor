@using Microsoft.AspNetCore.Components.Authorization
@using ZauberCMS.Core.Content.Parameters
@using ZauberCMS.Core.Content.Models
@using ZauberCMS.Core.Shared
@using ZauberCMS.Components.Admin.ContentSection.Dialogs
@using Microsoft.AspNetCore.Identity
@using ZauberCMS.Core.Membership.Models
@implements IDisposable

@if (Loading)
{
    <div class="pt-4 flex items-center justify-center">
        <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Medium">
            <Template>@L["content_loadingVersions"]</Template>
        </RadzenProgressBarCircular>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H5">@L["content_versionHistory"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="text-muted">@L["content_versionHistoryIntro"]</RadzenText>
        </div>
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                      Icon="refresh" Text="@L["general_refresh"]" Click="RefreshVersions"/>
    </div>

    @if (Versions.Any())
    {
        <RadzenDataGrid AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        Data="Versions"
                        TItem="ContentVersion">
            <Columns>
                <RadzenDataGridColumn Property="VersionNumber" Title="@L["content_version"]" Width="90px" Sortable="true">
                    <Template Context="version">
                        <div class="d-flex align-items-center">
                            @if (version.IsCurrentPublished)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success"
                                             Text="@version.VersionNumber.ToString()"/>
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                             Text="@version.VersionNumber.ToString()"/>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="DateCreated" Title="@L["general_date"]" Sortable="true" Width="150px">
                    <Template Context="version">
                        @version.DateCreated.Humanize()
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="CreatedBy.Name" Title="@L["content_author"]" Sortable="true">
                    <Template Context="version">
                        @if (version.CreatedBy != null)
                        {
                            <div class="d-flex align-items-center">
                                <RadzenGravatar Email="@version.CreatedBy.Email" Style="width: 24px; height: 24px;"
                                                class="me-2"/>
                                <span>@version.CreatedBy.Name</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">@L["content_systemUser"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="@L["general_actions"]" Width="280px">
                    <Template Context="version">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem" AlignItems="AlignItems.Stretch">
                            @if (!version.IsCurrentPublished)
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Info"
                                              Size="ButtonSize.Small"
                                              Icon="compare"
                                              Text="@L["content_compare"]"
                                              Click="() => CompareWithCurrent(version)"
                                              Title="@L["content_compareWithCurrent"]"
                                              Style="width: 100%; justify-content: flex-start;"/>
                            }

                            @if (CanRollback(version))
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Warning"
                                              Size="ButtonSize.Small"
                                              Icon="restore"
                                              Text="@L["general_restore"]"
                                              Click="() => RestoreToVersion(version.Id)"
                                              Title="@L["content_restoreToVersion"]"
                                              Style="width: 100%; justify-content: flex-start;"/>
                            }
                            else if (version.IsCurrentPublished)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["content_currentVersion"]" Size="BadgeSize.Small"/>
                            }
                            else
                            {
                                <small class="text-muted">@L["content_cannotRestore"]</small>
                            }
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
        <div class="text-center py-5">
            <RadzenIcon Icon="history" Size="IconSize.XLarge" class="text-muted mb-3"/>
            <RadzenText TextStyle="TextStyle.H6" class="text-muted mb-2">
                @L["content_noVersionHistory"]
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="text-muted">
                @L["content_noVersionHistoryDetail"]<br/>
                @L["content_noVersionHistoryHint"]
            </RadzenText>
        </div>
    }
}

@code {
    [Parameter] public Guid ContentId { get; set; }

    [Inject] public IContentVersioningService ContentVersioningService { get; set; } = null!;
    [Inject] public NotificationService NotificationService { get; set; } = null!;
    [Inject] public AppState AppState { get; set; } = null!;
    [Inject] public AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    [Inject] public UserManager<User> UserManager { get; set; } = null!;
    [CascadingParameter] public IModalService ModalService { get; set; } = null!;

    private bool Loading { get; set; } = true;
    private List<ContentVersion> Versions { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to content change events to refresh versions when content is saved
        AppState.OnContentSaved += HandleContentSaved;
        AppState.OnContentChanged += HandleContentChanged;

        await LoadVersionsAsync();
    }

    public void Dispose()
    {
        // Unsubscribe from events
        AppState.OnContentSaved -= HandleContentSaved;
        AppState.OnContentChanged -= HandleContentChanged;
    }

    // Events come from every admin circuit, on the publisher's thread: only this item's, on this circuit (ZA-080)
    private Task HandleContentSaved(ZauberCMS.Core.Content.Models.Content? content, string username)
        => ReloadIfOwnAsync(content);

    private Task HandleContentChanged(ZauberCMS.Core.Content.Models.Content? content, string username)
        => ReloadIfOwnAsync(content);

    private Task ReloadIfOwnAsync(ZauberCMS.Core.Content.Models.Content? content)
    {
        if (content?.Id != ContentId)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            await LoadVersionsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadVersionsAsync()
    {
        Loading = true;
        try
        {
            var parameters = new QueryContentVersionsParameters
            {
                ContentId = ContentId,
                AmountPerPage = 100,
                OrderBy = ContentVersionOrderBy.DateCreated,
                // The list shows names and dates; compare and restore load the versions they need (ZA-069)
                IncludeSnapshots = false
            };
            var result = await ContentVersioningService.GetContentVersionsAsync(parameters);
            Versions = result.Items.ToList();
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["content_errorLoadingVersions"],
                Detail = L["content_errorLoadingVersionsDetail"]
            });
        }
        finally
        {
            Loading = false;
        }
    }


    private bool CanRollback(ContentVersion version)
    {
        // Can only rollback to versions that aren't currently published
        return !version.IsCurrentPublished;
    }

    private async Task RestoreToVersion(Guid versionId)
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            
            var parameters = new PublishContentVersionParameters 
            { 
                VersionId = versionId,
                PublishedByUserId = user?.Id
            };
            var result = await ContentVersioningService.PublishVersionAsync(parameters);

            if (result.Success)
            {
                await LoadVersionsAsync();

                // Name the restored item, so only its editors reload (a null would reload every open editor)
                await AppState.NotifyContentChanged(new Content { Id = ContentId }, "system");

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = L["content_versionRestored"],
                    Detail = L["content_versionRestoredDetail"],
                    Duration = 4000
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = L["content_restoreFailed"],
                    Detail = L["content_restoreFailedDetail"],
                    Duration = 4000
                });
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["general_error"],
                Detail = L["content_restoreVersionError"],
                Duration = 4000
            });
        }
    }

    private async Task RefreshVersions()
    {
        await LoadVersionsAsync();
    }

    private async Task CompareWithCurrent(ContentVersion version)
    {
        try
        {
            // Find the current published version
            var currentVersion = Versions.FirstOrDefault(v => v.IsCurrentPublished);
            if (currentVersion == null)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = L["content_noCurrentVersion"],
                    Detail = L["content_noCurrentVersionDetail"],
                    Duration = 4000
                });
                return;
            }

            // Compare the selected version with the current version
            var comparison = await ContentVersioningService.CompareVersionsAsync(new CompareContentVersionsParameters
            {
                VersionId1 = version.Id,
                VersionId2 = currentVersion.Id
            });

            var parameters = new Dictionary<string, object>
            {
                { nameof(VersionComparison.Comparison), comparison },
                { nameof(VersionComparison.Loading), false }
            };

            var modal = ModalService.OpenSidePanel<VersionComparison>(L["content_versionComparison"], parameters);
            var result = await modal.Result;
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["content_comparisonFailed"],
                Detail = L["content_comparisonFailedDetail"],
                Duration = 4000
            });
        }
    }

}
