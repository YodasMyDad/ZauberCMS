@attribute [Route(Urls.AdminSettingsGlobalSettings)]
@* Administrators only, whoever else may open Settings: these settings decide who gets in (admin email addresses,
   the admin IP list, registration), what may be uploaded, and hold the API keys (Roadmap D70) *@
@attribute [Authorize(Roles = Constants.Roles.AdminRoleName)]
@layout SectionLayout

<PageTitle>Global Settings</PageTitle>

<RadzenPanel Class="rz-mx-auto">

    <RadzenTabs @bind-SelectedIndex="@SelectedIndex">
        <Tabs>
            <RadzenTabsItem Text="General">
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Site Name" Description="The name of the site. Views and emails can show it"/>
                    </LeftColumn>
                    <CentreColumn>
                        <RadzenTextBox Name="SiteName" @bind-Value="@GlobalSettingsModel.SiteName" MaxLength="200" Style="width: 100%"/>
                    </CentreColumn>
                </EditorRow>
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Default Language" Description="The culture (for example en-GB) of pages that have no language set on themselves, a parent page or their domain. Empty: the admin language is used"/>
                    </LeftColumn>
                    <CentreColumn>
                        <RadzenTextBox Name="DefaultLanguage" @bind-Value="@GlobalSettingsModel.DefaultLanguage" MaxLength="14" Style="width: 100%"/>
                    </CentreColumn>
                </EditorRow>
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Api Keys" Description="Keys that the API Key Picker and the editors (TinyMCE, Google Maps) use by name. A saved key's value is never shown again: type a new value to replace it. Pages and editor settings keep the name, so renaming or removing a key leaves them without it. A key in the site's configuration (Zauber:ApiKeys) wins over one of the same name here"/>
                    </LeftColumn>
                    <CentreColumn>
                        @* Values go one way (ZA-214, Roadmap D73): a saved value is kept on the server and never sent back
                           to the page; an empty box keeps it *@
                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                <RadzenTextBox @bind-Value="@_newApiKeyName" Placeholder="Name" aria-label="New API key name" Style="width: 100%"/>
                                <RadzenTextBox @bind-Value="@_newApiKeyValue" Placeholder="Value" aria-label="New API key value" autocomplete="off" Style="width: 100%"/>
                                <RadzenButton Click="@AddApiKey" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              class="rz-border-radius-10 rz-shadow-4" title="Add the key" aria-label="Add the key"/>
                            </RadzenStack>
                            @foreach (var row in _apiKeys.Rows)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" @key="row">
                                    <RadzenTextBox @bind-Value="@row.Name" aria-label="API key name" Style="width: 100%"/>
                                    <RadzenTextBox @bind-Value="@row.NewValue" autocomplete="off" Style="width: 100%"
                                                   Placeholder="@(row.SavedName != null ? "Saved: type a new value to replace it" : "Value")"
                                                   aria-label="@($"New value for the API key {row.Name}")"/>
                                    <RadzenButton Click="@(() => _apiKeys.Rows.Remove(row))" Icon="remove" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                  class="rz-border-radius-10 rz-shadow-4" title="Remove the key" aria-label="@($"Remove the API key {row.Name}")"/>
                                </RadzenStack>
                            }
                            @if (_configuredApiKeyNames.Count > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">
                                    In the site's configuration, which wins over a key of the same name here: @string.Join(", ", _configuredApiKeyNames)
                                </RadzenText>
                            }
                        </RadzenStack>
                    </CentreColumn>
                </EditorRow>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Media">
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Max Upload File Size" Description="The maximum allowed file size upload in bytes"/>
                    </LeftColumn>
                    <CentreColumn>
                        <RadzenNumeric @bind-Value="@GlobalSettingsModel.MaxUploadFileSizeInBytes"/>
                    </CentreColumn>
                </EditorRow>
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Max Image Size" Description="The maximum allowed width/height of an image in pixels (Images over this will be resized where possible)" />
                    </LeftColumn>
                    <CentreColumn>
                        <RadzenNumeric @bind-Value="@GlobalSettingsModel.MaxImageSizeInPixels"/>
                    </CentreColumn>
                </EditorRow>

                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Allowed File Types" Description="The allowed file types that can be uploaded into the CMS" />
                    </LeftColumn>
                    <CentreColumn>
                        <ListEditor TItem="string" @bind-Value="@GlobalSettingsModel.AllowedFileTypes"/>
                    </CentreColumn>
                </EditorRow>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Identity">
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Allow Registration" Description="Visitors can create an account, on the registration page or with a social login. Off: the registration page answers 404 and the link on the login page is hidden"/>
                    </LeftColumn>
                    <CentreColumn>
                        <RadzenSwitch Name="AllowRegistration" @bind-Value="@GlobalSettingsModel.AllowRegistration"/>
                    </CentreColumn>
                </EditorRow>
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Allowed Admin IP Addresses" Description="Restrict access to this admin CMS by IP address" />
                    </LeftColumn>
                    <CentreColumn>
                        <ListEditor TItem="string" @bind-Value="@GlobalSettingsModel.AllowedAdminIpAddress"/>
                    </CentreColumn>
                </EditorRow>
                <EditorRow>
                    <LeftColumn>
                        <PropertyInfo Name="Admin Email Addresses" Description="An account with one of these email addresses becomes an administrator once its owner has proven the address. A social login proves it. Someone who registers with a password is emailed a link to choose the password, and using it makes the account an administrator" />
                    </LeftColumn>
                    <CentreColumn>
                        <ListEditor TItem="string" @bind-Value="@GlobalSettingsModel.AdminEmailAddresses"/>
                    </CentreColumn>
                </EditorRow>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Icon="save" Text="Save" Click="Save"/>
    </RadzenStack>
</RadzenPanel>

@code {
    [CascadingParameter] protected SectionLayout? Layout { get; set; }
    
    [Inject] public NotificationService NotificationService { get; set; } = null!;
    [Inject] public Microsoft.Extensions.Options.IOptions<ZauberCMS.Core.Settings.ZauberSettings> ZauberSettings { get; set; } = null!;

    private int SelectedIndex { get; set; }
    private ZauberCMS.Core.Settings.GlobalSettings GlobalSettingsModel { get; set; } = new();

    // The API keys: names and typed values only; the saved values stay in ApiKeyEdits (D73)
    private ApiKeyEdits _apiKeys = new(new Dictionary<string, string>());
    private List<string> _configuredApiKeyNames = [];
    private string? _newApiKeyName;
    private string? _newApiKeyValue;
    
    protected override async Task OnInitializedAsync()
    {
        GlobalSettingsModel = await DataService.GetGlobalSettings();
        _apiKeys = new ApiKeyEdits(GlobalSettingsModel.ApiKeys);
        _configuredApiKeyNames = ZauberSettings.Value.ApiKeys
            .Where(x => !string.IsNullOrWhiteSpace(x.Key) && !string.IsNullOrEmpty(x.Value))
            .Select(x => x.Key).Order(StringComparer.OrdinalIgnoreCase).ToList();
        Layout?.SetSection(Constants.Sections.SettingsSection);
    }

    private void AddApiKey()
    {
        var problem = _apiKeys.Add(_newApiKeyName, _newApiKeyValue);
        if (problem != null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = problem, Duration = 6000 });
            return;
        }

        _newApiKeyName = null;
        _newApiKeyValue = null;
    }

    private async Task Save()
    {
        var (apiKeys, apiKeysProblem) = _apiKeys.ToSave();
        if (apiKeys == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = apiKeysProblem ?? "The API keys could not be saved", Duration = 6000 });
            return;
        }

        GlobalSettingsModel.ApiKeys = apiKeys;

        // A culture nobody can use would silently fall back; refuse it here instead
        var defaultLanguage = GlobalSettingsModel.DefaultLanguage?.Trim();
        if (string.IsNullOrEmpty(defaultLanguage))
        {
            GlobalSettingsModel.DefaultLanguage = null;
        }
        else
        {
            var culture = ZauberCMS.Core.Languages.CultureLookup.FindSpecific(defaultLanguage);
            if (culture == null)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Default Language is not a culture such as en-GB", Duration = 6000 });
                return;
            }

            GlobalSettingsModel.DefaultLanguage = culture.Name;
        }

        var result = await DataService.SaveGlobalSettings(GlobalSettingsModel);
        if (result)
        {
            // What was typed is saved: the boxes empty again
            _apiKeys.Load(apiKeys);
        }

        NotificationService.Notify(result ? new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Saved", Duration = 4000 } : new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "There was an error", Duration = 4000 });
    }
}