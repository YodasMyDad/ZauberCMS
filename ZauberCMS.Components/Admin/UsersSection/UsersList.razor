@using ZauberCMS.Core.Membership.Parameters
@using ZauberCMS.Core.Membership.Models

@attribute [Route($"{Urls.AdminUsersList}/{{RoleId:guid}}")]

@layout SectionLayout

<RadzenPanel Class="rz-mx-auto">

    <RadzenDataGrid AllowFiltering="true"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    AllowPaging="true"
                    PageSize="30"
                    AllowSorting="true"
                    Data="@Users"
                    SelectionMode="DataGridSelectionMode.Single"
                    RowSelect="@((User value) => OnRowSelect(value))">
        @*@bind-Value="@SelectedContent"*@
        <Columns>
            <RadzenDataGridColumn Property="Username" Title="@L["general_username"]"/>
            <RadzenDataGridColumn Property="Email" Title="@L["general_email"]"/>
            <RadzenDataGridColumn Property="DateUpdated" Title="@L["general_lastUpdated"]">
                <Template Context="data">
                    @data.DateUpdated.Humanize()
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    
</RadzenPanel>

@code {
    [Parameter] public Guid? RoleId { get; set; }
    
    [CascadingParameter] protected SectionLayout? Layout { get; set; }
    
    private IEnumerable<User> Users { get; set; } = [];
    private Guid? _loadedFor;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        // Only when the role changes, and a role that isn't found lists nobody, not the last role's users (ZA-127)
        if (_loaded && RoleId == _loadedFor)
        {
            return;
        }

        _loaded = true;
        _loadedFor = RoleId;
        Users = [];
        if (RoleId != null)
        {
            var role = await MembershipService.GetRoleAsync(new GetRoleParameters {Id = RoleId.Value});
            if (role?.Name != null)
            {
                var items = await MembershipService.QueryUsersAsync(new QueryUsersParameters
                {
                    AmountPerPage = 200,
                    OrderBy = GetUsersOrderBy.DateCreatedDescending,
                    Roles = [role.Name]
                });
                Users = items.Items;
            }
        }
    }

    protected override void OnInitialized()
    {
        Layout?.SetSection(Constants.Sections.UsersSection);
    }
    
    private void OnRowSelect(object value)
    {
        if (value is User selectedRow)
        {
            NavigationManager.NavigateTo($"{Urls.AdminUsersEdit}/{selectedRow.Id}");
        }
    }
}