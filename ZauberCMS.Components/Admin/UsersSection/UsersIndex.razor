@attribute [Route(Url)]
@layout SectionLayout
@implements ZauberCMS.Core.Sections.Interfaces.ISection

<PageTitle>@Name</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Reverse="true" Gap="5" Style="margin-top: 0; padding-top: 0; padding-bottom: 10px;">
    <RadzenButton Variant="Variant.Filled" Text="@L["users_createRole"]" Click="@(_ => NavigationManager.NavigateTo(Urls.AdminUsersAddRole))"/>
</RadzenStack>

<SectionDashboards SectionAlias="@(Alias)"/>

@code {
    private const string Url = Urls.AdminUsersBaseUrl;
    // Discovery builds this page to read the section's name, without [Inject]: the text comes through the constructor
    private readonly IStringLocalizer<ZauberText> _text;
    public UsersIndex(IStringLocalizer<ZauberText> text) => _text = text;
    public string Name => _text["sections_users"];
    public string Alias => Constants.Sections.UsersSection;
    public string IndexUrl => Url;
    public int SortOrder => 4;
    
    [CascadingParameter] protected SectionLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        Layout?.SetSection(Alias);
    }
}