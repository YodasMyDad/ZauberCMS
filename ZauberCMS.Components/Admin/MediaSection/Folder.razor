@using Microsoft.AspNetCore.Components.Authorization
@using ZauberCMS.Core.Media.Models
@using ZauberCMS.Core.Media.Parameters
@using ZauberCMS.Core.Shared
@using ZauberCMS.Core.Shared.Models
@layout SectionLayout
@implements IDisposable
@attribute [Route($"{Urls.AdminMediaFolder}/{{FolderId:guid}}")]

<PageTitle>@L["media_listingMedia"]</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Right" Gap="5" Style="margin-top: -5px; padding-top: 0; padding-bottom: 10px;">
    <RadzenButton Text="@L["general_edit"]" ButtonStyle="ButtonStyle.Secondary" Click="@(() => NavigationManager.NavigateTo($"{Urls.AdminUpdateMedia}/{FolderId}"))" />
    <CreateMediaButtons ParentId="FolderId"/>
</RadzenStack>

<RadzenPanel Class="rz-mx-auto">

    <RadzenTabs @bind-SelectedIndex="@SelectedIndex">
        <Tabs>
            <RadzenTabsItem Text="@L["general_media"]">
                <RadzenDataGrid AllowFiltering="false"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                AllowPaging="false"
                                PageSize="20"
                                AllowSorting="true"
                                Data="@Contents"
                                SelectionMode="DataGridSelectionMode.Single"
                                RowSelect="@((Media value) => OnRowSelect(value))">
                    <Columns>
                        <RadzenDataGridColumn Property="MediaType" Title="@L["general_type"]">
                            <Template Context="data">
                                @if (data.MediaType == MediaType.Image)
                                {
                                    <img src="@data.Url?width=25&height=25&rmode=max" class="rounded" alt=""/>
                                }
                                else
                                {
                                    <RadzenIcon Icon="@data.MediaType.GetIcon()"/>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Name" Title="@L["general_name"]">
                            <Template Context="data">
                                <div>@data.Name</div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="FileSize" Title="@L["general_size"]"/>
                        <RadzenDataGridColumn Property="DateUpdated" Title="@L["general_lastUpdated"]">
                            <Template Context="data">
                                @data.DateUpdated.Humanize()
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                @if (_more != null)
                {
                    @* A page at a time (Roadmap D26): the list used to stop at 200 items *@
                    <RadzenButton Text="@_more.Name" Icon="expand_more" Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Primary" Click="@LoadMoreAsync" class="rz-mt-2"/>
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="@L["general_upload"]">
                <MultipleMediaUpload ParentId="@FolderId"/>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

</RadzenPanel>


@code {
    [Inject] public AppState AppState { get; set; } = null!;
    [CascadingParameter] protected SectionLayout? Layout { get; set; }

    [Parameter] public Guid FolderId { get; set; }

    private IEnumerable<Media> Contents { get; set; } = [];
    private TreeLoadMore? _more;
    private int SelectedIndex { get; set; }
    private Media? EditFolder { get; set; }
    private AuthenticationState AuthState { get; set; } = null!;

    private Guid? _loadedFolderId;

    protected override async Task OnParametersSetAsync()
    {
        // Only when the folder changes: a re-render would drop the pages added with "Show more"
        if (_loadedFolderId == FolderId)
        {
            return;
        }

        _loadedFolderId = FolderId;
        await SetContents(FolderId);
        EditFolder = await MediaService.GetMediaAsync(new GetMediaParameters { Id = FolderId });
    }

    protected override void OnInitialized()
    {
        Layout?.SetSection(Constants.Sections.MediaSection);
        AppState.OnMediaChanged += HandleMediaChanged;
    }

    public void Dispose()
    {
        AppState.OnMediaChanged -= HandleMediaChanged;
    }

    private Task HandleMediaChanged(Media? media, string username)
        => InvokeAsync(async () =>
        {
            // This folder (or one above it) went to the recycle bin or was deleted
            if (await MediaService.GetMediaAsync(new GetMediaParameters { Id = FolderId }) == null)
            {
                NavigationManager.NavigateTo(Urls.AdminMediaBaseUrl);
                return;
            }

            // As many items as are shown, so an upload elsewhere doesn't fold the list back to its first page
            await SetContents(FolderId, Math.Max(Contents.Count(), TreeLoadMore.PageSize));
            StateHasChanged();
        });

    private async Task SetContents(Guid folderId, int take = TreeLoadMore.PageSize)
    {
        var level = await MediaService.GetMediaTreeLevelAsync(new MediaTreeLevelParameters
        {
            ParentId = folderId, Take = take
        });
        Contents = level.Items;
        _more = TreeLoadMore.After(level, folderId);
    }

    private async Task LoadMoreAsync()
    {
        if (_more == null)
        {
            return;
        }

        var level = await MediaService.GetMediaTreeLevelAsync(new MediaTreeLevelParameters
        {
            ParentId = FolderId, Skip = _more.Skip
        });
        // A new list, so the grid sees the change
        Contents = [.. Contents, .. level.Items];
        _more = TreeLoadMore.After(level, FolderId);
    }

    private void OnRowSelect(object value)
    {
        if (value is Media { MediaType: MediaType.Folder } folder)
        {
            NavigationManager.NavigateTo($"{Urls.AdminMediaFolder}/{folder.Id}");
        }
        else if (value is Media media)
        {
            NavigationManager.NavigateTo($"{Urls.AdminUpdateMedia}/{media.Id}");
        }
    }

}