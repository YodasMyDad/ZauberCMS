@using ZauberCMS.Core.Media.Parameters
@using ZauberCMS.Core.Media.Models
<RadzenSplitButton Click=@(args => OnClick(args, "CreateMedia"))
                   Text="@L["media_createFolder"]">
    <ChildContent>
        @if (Media is { MediaType: MediaType.Folder })
        {
            <RadzenSplitButtonItem Text="@L["media_createFile"]" Value="File"/>
        }
    </ChildContent>
</RadzenSplitButton>
@code {
    [Parameter] public Guid? ParentId { get; set; }
    private Media? Media { get; set; }
    private Guid? _loadedFor;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        // Only when the folder changes; at the root there is no folder, so no "Create File" from an old one (ZA-127)
        if (_loaded && ParentId == _loadedFor)
        {
            return;
        }

        _loaded = true;
        _loadedFor = ParentId;
        Media = ParentId == null ? null : await MediaService.GetMediaAsync(new GetMediaParameters { Id = ParentId.Value });
    }

    private void OnClick(RadzenSplitButtonItem? item, string buttonName)
    {
        var action = item != null ? Urls.AdminCreateMedia : Urls.AdminCreateMediaFolder;
        var path = ParentId != null ? $"{action}/{ParentId}" : $"{action}";
        NavigationManager.NavigateTo(NavigationManager.ToSiteUrl(path));
    }
}