@* Administrator, site, starter content and review are one form, sent once: nothing is saved until the last
   button, so an abandoned install leaves nothing behind. The script shows one part at a time; without it the
   parts follow each other on the page. *@
<form method="post" action="@Model.FormAction" data-installer data-start="@Model.StartPane">
    <input type="hidden" name="@Model.AntiforgeryFieldName" value="@Model.AntiforgeryToken"/>
    <input type="hidden" name="step" value="setup"/>

    @* Above the parts, so a refused install is explained whichever part is open *@
    <InstallerNotices Model="Model"/>

    <section data-pane="admin">
        <h1>@L["installer_adminHeading"]</h1>
        <p class="lead">@L["installer_adminLead"]</p>

        <div class="field">
            <label for="admin-name">@L["installer_userName"]</label>
            @* Sign-in is by email address: that field is the "username" a password manager should save *@
            <input type="text" id="admin-name" name="adminName" value="@Model.Setup.AdminName" required maxlength="150" autocomplete="nickname" aria-describedby="admin-name-hint"/>
            <span class="hint" id="admin-name-hint">@L["installer_adminNameHint"]</span>
        </div>
        <div class="field">
            <label for="admin-email">@L["installer_emailAddress"]</label>
            <input type="email" id="admin-email" name="adminEmail" value="@Model.Setup.AdminEmail" required maxlength="256" autocomplete="username"/>
        </div>
        <div class="field">
            <label for="admin-password">@L["installer_password"]</label>
            <div class="with-button">
                <input type="password" id="admin-password" name="adminPassword" required autocomplete="new-password" aria-describedby="admin-password-rules"/>
                <button type="button" class="quiet" data-reveal="admin-password" data-show="@L["installer_show"]" data-hide="@L["installer_hide"]">@L["installer_show"]</button>
            </div>
            <span class="hint" id="admin-password-rules">@Model.PasswordRules</span>
        </div>

        <div class="actions">
            <button type="button" data-go="next">@L["installer_continue"]</button>
        </div>
    </section>

    <section data-pane="site">
        <h1>@L["installer_siteHeading"]</h1>
        <p class="lead">@L["installer_siteLead"]</p>

        <div class="field">
            <label for="site-name">@L["installer_siteName"]</label>
            <input type="text" id="site-name" name="siteName" value="@Model.Setup.SiteName" required maxlength="200"/>
        </div>
        @if (Model.Languages.Count > 0)
        {
            <div class="field">
                <label for="site-language">@L["installer_language"]</label>
                <select id="site-language" name="language" required aria-describedby="site-language-hint">
                    @foreach (var language in Model.Languages)
                    {
                        <option value="@language.Value" selected="@(language.Value == Model.Setup.Language)">@language.Name</option>
                    }
                </select>
                <span class="hint" id="site-language-hint">@L["installer_languageHint"]</span>
            </div>
        }
        <div class="check">
            <input type="checkbox" id="site-registration" name="allowRegistration" value="true" checked="@Model.Setup.AllowRegistration" aria-describedby="site-registration-hint"/>
            <label for="site-registration">@L["installer_allowRegistration"]</label>
            <span class="hint" id="site-registration-hint">@L["installer_allowRegistrationHint"]</span>
        </div>

        <div class="actions">
            <button type="button" data-go="next">@L["installer_continue"]</button>
            <button type="button" class="plain" data-go="back">@L["installer_back"]</button>
        </div>
    </section>

    <section data-pane="starter">
        <h1>@L["installer_starterHeading"]</h1>
        <p class="lead">@L["installer_starterLead"]</p>

        <fieldset>
            <legend class="legend">@L["installer_starterContent"]</legend>
            <div class="choices">
                @foreach (var kit in Model.StarterKits)
                {
                    <label class="choice">
                        <input type="radio" name="starterKit" value="@kit.Value" data-label="@kit.Name" checked="@(kit.Value == (Model.Setup.StarterKit ?? string.Empty))"/>
                        <span><b>@kit.Name</b>@kit.Description</span>
                    </label>
                }
            </div>
            @if (Model.StarterKits.Count == 1)
            {
                <span class="hint">@InstallerMarkup.WithCode(L["installer_noStarterKits"], "dotnet new zaubercms")</span>
            }
        </fieldset>

        <div class="actions">
            <button type="button" data-go="next">@L["installer_continue"]</button>
            <button type="button" class="plain" data-go="back">@L["installer_back"]</button>
        </div>
    </section>

    <section data-pane="review">
        <h1>@L["installer_reviewHeading"]</h1>
        <p class="lead">@L["installer_reviewLead"]</p>

        <dl class="review">
            <div><dt>@L["installer_database"]</dt><dd>@Model.ConfiguredDatabase</dd></div>
            <div><dt>@L["installer_administrator"]</dt><dd><span data-review="adminName"></span><br/><span data-review="adminEmail"></span></dd></div>
            <div><dt>@L["installer_siteName"]</dt><dd data-review="siteName"></dd></div>
            @if (Model.Languages.Count > 0)
            {
                <div><dt>@L["installer_language"]</dt><dd data-review="language"></dd></div>
            }
            <div><dt>@L["installer_visitorAccounts"]</dt><dd data-review="allowRegistration" data-on="@L["installer_visitorsCanRegister"]" data-off="@L["installer_noRegistration"]"></dd></div>
            <div><dt>@L["installer_starterContent"]</dt><dd data-review="starterKit"></dd></div>
        </dl>

        <div class="actions">
            <button type="submit">@L["installer_installZauberCms"]</button>
            <button type="button" class="plain" data-go="back">@L["installer_back"]</button>
        </div>
    </section>
</form>

@code {
    [Parameter, EditorRequired] public InstallerPageModel Model { get; set; } = null!;
}
