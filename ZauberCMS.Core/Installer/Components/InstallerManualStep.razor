<h1>@L["installer_manualHeading"]</h1>
<p class="lead">
    @L["installer_manualLead", Model.ManualConfiguration?.ManualConfigurationReason ?? string.Empty]
</p>

@if (Model.ManualConfiguration?.SettingsFileWritten == true)
{
    <p>
        @InstallerMarkup.WithCode(L["installer_manualOverridden"], "appsettings.json", "Zauber:DatabaseProvider",
            "Zauber:ConnectionString", "Zauber__DatabaseProvider", "Zauber__ConnectionString")
    </p>
    <pre>@Snippet</pre>
}
else
{
    <p>@L["installer_manualSettings"]</p>

    <p>@InstallerMarkup.WithCode(L["installer_manualInFile"], "appsettings.json")</p>
    <pre>@Snippet</pre>

    <p>@L["installer_manualAsVariables"]</p>
    <pre>Zauber__DatabaseProvider=@Model.ManualConfiguration?.DatabaseProvider
Zauber__ConnectionString=@Model.ManualConfiguration?.ConnectionString</pre>
}

<p>
    @L["installer_manualCopy"]
</p>

<div class="actions">
    <a class="button" href="@Model.FormAction">@L["installer_openAgain"]</a>
</div>

@code {
    [Parameter, EditorRequired] public InstallerPageModel Model { get; set; } = null!;

    private string Snippet => AppSettingsWriter.Snippet(
        Model.ManualConfiguration?.DatabaseProvider ?? string.Empty,
        Model.ManualConfiguration?.ConnectionString ?? string.Empty);
}
