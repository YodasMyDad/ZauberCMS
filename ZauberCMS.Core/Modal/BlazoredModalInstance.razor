@if (UseCustomLayout)
{
    <CascadingValue Value="this" IsFixed="true">
        @GuardedContent
    </CascadingValue>
}
else
{
    <div class="bm-container @Position @OverlayCustomClass @OverlayAnimationClass"
        @ref="_modalReference"
        @onmousedown="ListenToBackgroundClick"
        @onmouseup="HandleBackgroundClick"
        @onclick="StopListeningToBackgroundClick">

        <FocusTrap @ref="FocusTrap" IsActive="ActivateFocusTrap">
            <div class="@ModalClass" role="dialog" aria-modal="true" @onmouseup:stopPropagation="true" @onmousedown:stopPropagation="true">
                @if (!HideHeader)
                {
                    <div class="bm-header">
                        @if (!string.IsNullOrWhiteSpace(Title))
                        {
                            <h3 class="bm-title">@Title</h3>
                        }
                        @if (!HideCloseButton)
                        {
                            <button type="button" class="bm-close" aria-label="close" @onclick="() => CancelAsync()" @attributes="@_closeBtnAttributes">
                                <span>&times;</span>
                            </button>
                        }
                    </div>
                }
                <div class="bm-content">
                    <CascadingValue Value="this" IsFixed="true">
                        @GuardedContent
                    </CascadingValue>
                </div>
            </div>
        </FocusTrap>
        
    </div>
}

@code {
    // ZauberCMS (ZA-097, Roadmap D32): a panel whose content throws shows the error inside the panel, which can be
    // tried again or closed, instead of ending the circuit and every unsaved change in the panels below it. The
    // exception is logged by ErrorBoundary; its message shows only with Blazor's detailed errors on.
    [Inject] private Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Components.Server.CircuitOptions> CircuitOptions { get; set; } = default!;

    private ErrorBoundary? _contentBoundary;

    private RenderFragment GuardedContent => @<ErrorBoundary @ref="_contentBoundary">
        <ChildContent>@Content</ChildContent>
        <ErrorContent Context="exception">
            <div class="bm-error" role="alert">
                <p class="bm-error-title">This panel could not be shown.</p>
                <p>@(CircuitOptions.Value.DetailedErrors ? $"{exception.GetType().Name}: {exception.Message}" : "The details are in the site's log.")</p>
                <div class="bm-error-actions">
                    <button type="button" class="rz-button rz-button-sm rz-variant-outlined rz-primary"
                            @onclick="() => _contentBoundary?.Recover()">Try again</button>
                    <button type="button" class="rz-button rz-button-sm rz-variant-text rz-base"
                            @onclick="() => CancelAsync()">Close</button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>;
}
